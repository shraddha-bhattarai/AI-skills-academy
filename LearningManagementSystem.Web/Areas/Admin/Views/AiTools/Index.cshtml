@model PagedResult<AiToolDto>
@{
    ViewData["Title"] = "AI Tools";
    var search = ViewBag.Search as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="bi bi-robot me-2"></i>AI Tools</h1>
        <a asp-area="Admin" asp-controller="AiTools" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Tool
        </a>
    </div>

    <form method="get" asp-area="Admin" asp-controller="AiTools" asp-action="Index" class="row g-2 mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search tools..." />
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white rounded shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>URL</th>
                    <th>Useful Votes</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No AI tools added yet.</td></tr>
                }
                @foreach (var tool in Model.Items)
                {
                    <tr>
                        <td>@tool.Name</td>
                        <td>@tool.Category</td>
                        <td><a href="@tool.Url" target="_blank">@tool.Url</a></td>
                        <td><span class="badge bg-success">@tool.UsefulCount</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-area="Admin" asp-controller="AiTools" asp-action="Edit" asp-route-id="@tool.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-area="Admin" asp-controller="AiTools" asp-action="Delete" asp-route-id="@tool.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this AI tool?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="Model" />
</div>
