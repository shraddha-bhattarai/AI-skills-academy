@model CreateNotificationDto
@{
    ViewData["Title"] = "Create Notification";
}

@section Styles {
<style>
    .form-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        padding: 2.25rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .form-header {
        border-bottom: 1px solid #edf2f7;
        padding-bottom: 1.25rem;
        margin-bottom: 1.75rem;
    }

    .form-header h2 {
        font-weight: 700;
        font-size: 1.5rem;
        color: var(--lms-dark, #1c1d1f);
        margin-bottom: 0.25rem;
    }

    .form-header p {
        color: var(--lms-muted, #6a6f73);
        font-size: 0.9rem;
        margin: 0;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.88rem;
        color: var(--lms-dark, #1c1d1f);
        margin-bottom: 0.4rem;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 0.65rem 1rem;
        font-size: 0.92rem;
        border: 1px solid #cbd5e1;
        transition: var(--lms-transition, all 0.2s ease);
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--lms-primary, #5624d0);
        box-shadow: 0 0 0 3px rgba(86, 36, 208, 0.15);
    }

    .btn-submit {
        background: var(--lms-gradient, linear-gradient(135deg, #5624d0, #7c3aed));
        color: #fff;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.7rem 1.8rem;
        border: none;
        box-shadow: 0 4px 14px rgba(86, 36, 208, 0.25);
        transition: var(--lms-transition, all 0.3s ease);
    }

    .btn-submit:hover {
        opacity: 0.92;
        color: #fff;
        transform: translateY(-2px);
    }

    .btn-cancel {
        background: #f1f5f9;
        color: var(--lms-muted, #6a6f73);
        font-weight: 600;
        border-radius: 10px;
        padding: 0.7rem 1.5rem;
        border: none;
        text-decoration: none;
        transition: var(--lms-transition, all 0.2s ease);
        display: inline-flex;
        align-items: center;
    }

    .btn-cancel:hover {
        background: #e2e8f0;
        color: var(--lms-dark, #1c1d1f);
    }
</style>
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Notifications" asp-action="Index" class="text-decoration-none text-muted">Notifications</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Create Notification</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-card">
                <div class="form-header">
                    <h2><i class="bi bi-bell-fill text-primary me-2"></i>Create Notification</h2>
                    <p>Send a targeted notification or announcement to a student or user in AI Skills Academy.</p>
                </div>

                <form asp-area="Admin" asp-controller="Notifications" asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="UserId" class="form-label"></label>
                            <select asp-for="UserId" asp-items="ViewBag.UserId" class="form-select">
                                <option value="">-- Select Recipient User --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter notification title..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Type" class="form-label"></label>
                            <select asp-for="Type" asp-items="ViewBag.Type" class="form-select">
                            </select>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Message" class="form-label"></label>
                            <textarea asp-for="Message" class="form-control" rows="5" placeholder="Enter notification message content..."></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsRead" class="form-check-input" type="checkbox" role="switch" id="isReadSwitch">
                                <label class="form-check-label small fw-semibold text-dark" for="isReadSwitch">
                                    Mark as already read
                                </label>
                            </div>
                            <span asp-validation-for="IsRead" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top d-flex align-items-center justify-content-end gap-2">
                            <a asp-area="Admin" asp-controller="Notifications" asp-action="Index" class="btn btn-cancel">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-submit">
                                <i class="bi bi-send-fill me-1"></i> Send Notification
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
