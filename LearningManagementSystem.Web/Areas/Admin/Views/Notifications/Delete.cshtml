@model NotificationDto
@{
    ViewData["Title"] = "Delete Notification";
    var recipientDisplay = string.IsNullOrWhiteSpace(Model.UserName) ? Model.UserId : Model.UserName;

    var typeClass = Model.Type switch
    {
        NotificationType.Assignment => "type-assignment",
        NotificationType.Quiz => "type-quiz",
        NotificationType.Course => "type-course",
        _ => "type-general"
    };

    var typeIcon = Model.Type switch
    {
        NotificationType.Assignment => "bi-file-earmark-text",
        NotificationType.Quiz => "bi-patch-question",
        NotificationType.Course => "bi-journal-bookmark",
        _ => "bi-info-circle"
    };
}

@section Styles {
<style>
    .delete-hero {
        background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #b91c1c 100%);
        border-radius: var(--lms-radius, 16px);
        padding: 2.25rem 2rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(185, 28, 28, 0.15);
    }

    .delete-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(239, 68, 68, 0.25) 0%, transparent 60%);
    }

    .details-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        padding: 2rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .meta-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid #edf2f7;
    }

    .meta-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--lms-muted, #6a6f73);
        margin-bottom: 0.25rem;
    }

    .meta-value {
        font-size: 1rem;
        font-weight: 700;
        color: var(--lms-dark, #1c1d1f);
    }

    .type-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.7rem;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .type-general {
        background: rgba(59, 130, 246, 0.12);
        color: #2563eb;
    }

    .type-assignment {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
    }

    .type-quiz {
        background: rgba(139, 92, 246, 0.12);
        color: #7c3aed;
    }

    .type-course {
        background: rgba(16, 185, 129, 0.12);
        color: #059669;
    }

    .notification-content-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid #edf2f7;
        font-size: 0.92rem;
        line-height: 1.6;
        color: var(--lms-dark, #1c1d1f);
        white-space: pre-wrap;
    }
</style>
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Notifications" asp-action="Index" class="text-decoration-none text-muted">Notifications</a></li>
            <li class="breadcrumb-item active text-danger fw-semibold" aria-current="page">Delete Notification</li>
        </ol>
    </nav>

    @* ── Delete Warning Hero ── *@
    <div class="delete-hero">
        <div class="position-relative">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <span class="fw-bold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Confirm Deletion</span>
            </div>
            <h1 class="fw-bold mb-2" style="font-size: 1.85rem;">Delete Notification</h1>
            <p class="opacity-90 mb-0">Are you sure you want to delete this notification? This action will remove it from the system.</p>
        </div>
    </div>

    <div class="details-card mb-4">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-bell text-danger me-2"></i>Notification Details</h5>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <div class="meta-box">
                    <div class="meta-label">Recipient</div>
                    <div class="meta-value">@recipientDisplay</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="meta-box">
                    <div class="meta-label">Type</div>
                    <div class="meta-value">
                        <span class="type-badge @typeClass">
                            <i class="bi @typeIcon"></i> @Model.Type
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="meta-box">
                    <div class="meta-label">Title</div>
                    <div class="meta-value">@Model.Title</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="meta-box">
                    <div class="meta-label">Sent Date</div>
                    <div class="meta-value">@Model.CreatedAt.ToString("MMMM d, yyyy 'at' h:mm tt")</div>
                </div>
            </div>
        </div>

        <div class="meta-label mb-2">Message</div>
        <div class="notification-content-box">
            @Model.Message
        </div>
    </div>

    <div class="d-flex gap-2">
        <form asp-area="Admin" asp-controller="Notifications" asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger fw-semibold px-4" style="border-radius: 10px; padding: 0.65rem 1.5rem;">
                <i class="bi bi-trash me-1"></i> Yes, Delete Notification
            </button>
        </form>
        <a asp-area="Admin" asp-controller="Notifications" asp-action="Index" class="btn btn-light text-muted fw-semibold" style="border-radius: 10px; padding: 0.65rem 1.5rem;">
            <i class="bi bi-x-circle me-1"></i> Cancel
        </a>
    </div>
</div>
