@model LearningManagementSystem.Application.Common.PagedResult<QuizDto>
@{
    ViewData["Title"] = "Quizzes";
    var search = ViewBag.Search as string;
    var sortBy = ViewBag.SortBy as string;
    var sortDescending = ViewBag.SortDescending is bool desc && desc;
    var selectedCourseId = ViewBag.CourseId as int?;
    var courseList = ViewBag.CourseList as IReadOnlyList<LearningManagementSystem.Application.Common.LookupItemDto>
                    ?? new List<LearningManagementSystem.Application.Common.LookupItemDto>();
}

@section Styles {
<style>
    .admin-quizzes-header {
        background: linear-gradient(135deg, #1e1065 0%, #5624d0 55%, #7c3aed 100%);
        border-radius: var(--lms-radius, 16px);
        padding: 2.25rem 2rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(86, 36, 208, 0.18);
    }

    .admin-quizzes-header::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .admin-quizzes-header h1 { font-weight: 800; font-size: 1.85rem; margin-bottom: 0.35rem; }
    .admin-quizzes-header p  { opacity: 0.9; margin-bottom: 0; font-size: 0.95rem; }

    .btn-create-quiz {
        background: #fff;
        color: var(--lms-primary, #5624d0);
        font-weight: 700;
        border-radius: 12px;
        padding: 0.65rem 1.4rem;
        font-size: 0.9rem;
        border: none;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }
    .btn-create-quiz:hover {
        background: #f8f9fa;
        color: var(--lms-primary-dark, #401b9c);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    }

    .filter-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        padding: 1.25rem 1.5rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
        margin-bottom: 1.5rem;
    }
    .filter-card .form-control,
    .filter-card .form-select {
        border-radius: 10px;
        font-size: 0.9rem;
        padding: 0.55rem 0.9rem;
        border: 1px solid #e2e8f0;
    }
    .filter-card .form-control:focus,
    .filter-card .form-select:focus {
        border-color: var(--lms-primary, #5624d0);
        box-shadow: 0 0 0 3px rgba(86, 36, 208, 0.15);
    }

    .btn-filter {
        background: var(--lms-gradient, linear-gradient(135deg, #5624d0, #7c3aed));
        color: #fff; font-weight: 600; border-radius: 10px;
        padding: 0.55rem 1.25rem; border: none; transition: all 0.2s ease;
    }
    .btn-filter:hover { opacity: 0.92; color: #fff; transform: translateY(-1px); }

    .btn-reset {
        border-radius: 10px; font-weight: 600; font-size: 0.9rem;
        padding: 0.55rem 1rem; color: var(--lms-muted, #6a6f73);
        background: #f1f5f9; border: none; text-decoration: none;
        display: inline-flex; align-items: center; gap: 0.4rem;
    }
    .btn-reset:hover { background: #e2e8f0; color: var(--lms-dark, #1c1d1f); }

    .table-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .quizzes-table { margin-bottom: 0; }

    .quizzes-table thead th {
        background: #f8fafc;
        color: var(--lms-muted, #6a6f73);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #edf2f7;
        white-space: nowrap;
    }
    .quizzes-table thead th a {
        color: inherit; text-decoration: none;
        display: inline-flex; align-items: center; gap: 0.25rem;
    }
    .quizzes-table thead th a:hover { color: var(--lms-primary, #5624d0); }

    .quizzes-table tbody td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.88rem;
    }
    .quizzes-table tbody tr:last-child td { border-bottom: none; }
    .quizzes-table tbody tr:hover td { background-color: #fafbfc; }

    .quiz-icon {
        width: 38px; height: 38px; border-radius: 10px;
        background: linear-gradient(135deg, #5624d0, #7c3aed);
        display: inline-flex; align-items: center; justify-content: center;
        color: #fff; font-size: 1rem; flex-shrink: 0;
    }
    .quiz-title { font-weight: 600; color: var(--lms-dark, #1c1d1f); font-size: 0.92rem; }

    .marks-badge {
        display: inline-flex; align-items: center; gap: 0.3rem;
        background: rgba(86,36,208,0.08); color: #5624d0;
        border-radius: 50px; padding: 0.2rem 0.65rem;
        font-size: 0.78rem; font-weight: 700;
    }
    .questions-badge {
        display: inline-flex; align-items: center; gap: 0.3rem;
        background: rgba(16,185,129,0.1); color: #059669;
        border-radius: 50px; padding: 0.2rem 0.65rem;
        font-size: 0.78rem; font-weight: 700;
    }

    .action-btn-group { display: flex; align-items: center; justify-content: flex-end; gap: 0.4rem; }
    .action-btn {
        width: 34px; height: 34px; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 0.9rem; text-decoration: none;
        transition: all 0.2s ease; border: 1px solid transparent;
    }
    .action-btn-view   { color: var(--lms-primary, #5624d0); background: rgba(86,36,208,0.08); }
    .action-btn-view:hover { background: var(--lms-primary, #5624d0); color: #fff; }
    .action-btn-edit   { color: #b57c00; background: rgba(250,173,20,0.12); }
    .action-btn-edit:hover { background: #b57c00; color: #fff; }
    .action-btn-delete { color: #c93357; background: rgba(245,87,108,0.12); }
    .action-btn-delete:hover { background: #c93357; color: #fff; }

    .empty-quizzes { text-align: center; padding: 4rem 1.5rem; color: var(--lms-muted, #6a6f73); }
    .empty-quizzes i { font-size: 3rem; color: #cbd5e1; display: block; margin-bottom: 1rem; }
</style>
}

<div class="container py-4">

    @* ── Header Banner ── *@
    <div class="admin-quizzes-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="position-relative">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge rounded-pill bg-white text-dark px-3 py-1 fw-bold" style="font-size:0.7rem;letter-spacing:.5px;text-transform:uppercase;">
                    <i class="bi bi-patch-question-fill me-1 text-primary"></i> Quiz Management
                </span>
            </div>
            <h1>Quizzes</h1>
            <p>Create, manage, and organize quizzes for your courses.</p>
        </div>
        <div class="position-relative">
            <a asp-area="Admin" asp-controller="Quizzes" asp-action="Create" class="btn-create-quiz" id="btnCreateQuiz">
                <i class="bi bi-plus-lg"></i> Create Quiz
            </a>
        </div>
    </div>

    @* ── Filter Card ── *@
    <div class="filter-card">
        <form method="get" asp-area="Admin" asp-controller="Quizzes" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-lg-6 col-md-6">
                <label for="search" class="form-label small fw-semibold text-muted mb-1">Search Quizzes</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" id="search" name="search" value="@search"
                           class="form-control border-start-0 ps-0"
                           placeholder="Search by title or course name..." />
                </div>
            </div>
            <div class="col-lg-3 col-md-3">
                <label for="courseFilter" class="form-label small fw-semibold text-muted mb-1">Filter by Course</label>
                <select id="courseFilter" name="courseId" class="form-select">
                    <option value="">All Courses</option>
                    @foreach (var c in courseList)
                    {
                        <option value="@c.Id" selected="@(selectedCourseId?.ToString() == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-3 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-filter flex-grow-1">
                    <i class="bi bi-search me-1"></i> Search
                </button>
                @if (!string.IsNullOrWhiteSpace(search) || selectedCourseId.HasValue)
                {
                    <a asp-area="Admin" asp-controller="Quizzes" asp-action="Index" class="btn btn-reset">
                        <i class="bi bi-x-circle"></i> Reset
                    </a>
                }
            </div>
        </form>
    </div>

    @* ── Quizzes Table Card ── *@
    <div class="table-card">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table quizzes-table align-middle">
                    <thead>
                        <tr>
                            <th>
                                <a asp-area="Admin" asp-controller="Quizzes" asp-action="Index"
                                   asp-route-sortBy="title"
                                   asp-route-sortDescending="@(sortBy == "title" ? !sortDescending : false)"
                                   asp-route-search="@search"
                                   asp-route-courseId="@selectedCourseId">
                                    Quiz
                                    @if (sortBy == "title") { <i class="bi bi-arrow-@(sortDescending ? "down" : "up") text-primary ms-1"></i> }
                                </a>
                            </th>
                            <th>
                                <a asp-area="Admin" asp-controller="Quizzes" asp-action="Index"
                                   asp-route-sortBy="course"
                                   asp-route-sortDescending="@(sortBy == "course" ? !sortDescending : false)"
                                   asp-route-search="@search"
                                   asp-route-courseId="@selectedCourseId">
                                    Course
                                    @if (sortBy == "course") { <i class="bi bi-arrow-@(sortDescending ? "down" : "up") text-primary ms-1"></i> }
                                </a>
                            </th>
                            <th>
                                <a asp-area="Admin" asp-controller="Quizzes" asp-action="Index"
                                   asp-route-sortBy="totalmarks"
                                   asp-route-sortDescending="@(sortBy == "totalmarks" ? !sortDescending : false)"
                                   asp-route-search="@search"
                                   asp-route-courseId="@selectedCourseId">
                                    Total Marks
                                    @if (sortBy == "totalmarks") { <i class="bi bi-arrow-@(sortDescending ? "down" : "up") text-primary ms-1"></i> }
                                </a>
                            </th>
                            <th>Questions</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quiz in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="quiz-icon">
                                            <i class="bi bi-patch-question"></i>
                                        </div>
                                        <div class="quiz-title">@quiz.Title</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill" style="background:rgba(86,36,208,0.1);color:#5624d0;font-size:0.78rem;font-weight:600;padding:0.3rem 0.75rem;">
                                        <i class="bi bi-journal-bookmark me-1"></i>@quiz.CourseTitle
                                    </span>
                                </td>
                                <td>
                                    <span class="marks-badge">
                                        <i class="bi bi-star"></i> @quiz.TotalMarks pts
                                    </span>
                                </td>
                                <td>
                                    <span class="questions-badge">
                                        <i class="bi bi-list-check"></i> @quiz.QuestionCount Qs
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">@quiz.CreatedAt.ToString("MMM d, yyyy")</span>
                                </td>
                                <td>
                                    <div class="action-btn-group">
                                        <a asp-area="Admin" asp-controller="Quizzes" asp-action="Details" asp-route-id="@quiz.Id"
                                           class="action-btn action-btn-view" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Quizzes" asp-action="Edit" asp-route-id="@quiz.Id"
                                           class="action-btn action-btn-edit" title="Edit Quiz">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Quizzes" asp-action="Delete" asp-route-id="@quiz.Id"
                                           class="action-btn action-btn-delete" title="Delete Quiz">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-3 border-top">
                <partial name="_Pagination" model="Model" />
            </div>
        }
        else
        {
            <div class="empty-quizzes">
                <i class="bi bi-patch-question"></i>
                <h5 class="fw-bold text-dark mb-1">No Quizzes Found</h5>
                <p class="text-muted mb-3">
                    @if (!string.IsNullOrWhiteSpace(search) || selectedCourseId.HasValue)
                    {
                        <span>No quizzes match your search criteria. Try adjusting your filters.</span>
                    }
                    else
                    {
                        <span>No quizzes have been created yet.</span>
                    }
                </p>
                <a asp-area="Admin" asp-controller="Quizzes" asp-action="Create" class="btn btn-filter px-4">
                    <i class="bi bi-plus-lg me-1"></i> Create Quiz
                </a>
            </div>
        }
    </div>

</div>
