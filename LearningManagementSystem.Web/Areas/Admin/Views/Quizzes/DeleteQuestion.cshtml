@model QuestionDto
@{
    ViewData["Title"] = "Delete Question";
}

<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-7"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5">
    <h1 class="h3 fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Question</h1><p class="text-muted">This permanently removes the question from the quiz.</p>
    <div class="alert alert-warning"><i class="bi bi-info-circle me-1"></i>The question cannot be recovered after deletion.</div><div class="p-3 rounded-3 bg-light"><div class="fw-semibold">@Model.QuestionText</div><div class="small text-muted mt-2">Quiz: @Model.QuizTitle</div></div>
    <form asp-action="DeleteQuestion" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-end gap-2 mt-4"><input type="hidden" name="quizId" value="@Model.QuizId" /><a asp-action="Details" asp-route-id="@Model.QuizId" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete Question</button></form>
</div></div></div></div></div>
