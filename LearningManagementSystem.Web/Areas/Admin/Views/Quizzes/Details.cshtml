@model LearningManagementSystem.Domain.Entities.Quizzes.Quiz
@{
    ViewData["Title"] = "Quiz Details";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb small"><li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li><li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Quizzes</a></li><li class="breadcrumb-item active text-primary">@Model.Title</li></ol></nav>
    <div class="rounded-4 p-4 p-md-5 mb-4 text-white shadow-sm" style="background:var(--lms-gradient,linear-gradient(135deg,#5624d0,#7c3aed));"><div class="d-flex flex-wrap justify-content-between gap-3 align-items-start"><div><span class="badge bg-white text-primary rounded-pill mb-2"><i class="bi bi-journal-bookmark me-1"></i>@Model.Course.Title</span><h1 class="h2 fw-bold mb-1">@Model.Title</h1><p class="mb-0 opacity-75">Created @Model.CreatedAt.ToString("MMM d, yyyy")</p></div><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light"><i class="bi bi-pencil me-1"></i>Edit</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-light"><i class="bi bi-trash me-1"></i>Delete</a></div></div></div>
    <div class="row g-4"><div class="col-lg-4"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4"><h2 class="h5 fw-bold mb-3">Quiz information</h2><dl class="mb-0"><dt class="small text-muted text-uppercase">Course</dt><dd class="fw-semibold mb-3">@Model.Course.Title</dd><dt class="small text-muted text-uppercase">Total marks</dt><dd class="fw-semibold mb-3">@Model.TotalMarks points</dd><dt class="small text-muted text-uppercase">Questions</dt><dd class="fw-semibold mb-0">@Model.Questions.Count</dd></dl></div></div></div>
        <div class="col-lg-8"><div class="card border-0 shadow-sm rounded-4"><div class="card-header bg-white border-0 p-4 pb-0 d-flex justify-content-between align-items-center"><h2 class="h5 fw-bold mb-0">Questions</h2><a asp-action="AddQuestion" asp-route-quizId="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Question</a></div><div class="card-body p-4">
            @if (Model.Questions.Any()) { <div class="list-group list-group-flush">@foreach (var question in Model.Questions.OrderBy(q => q.Id)) { <div class="list-group-item px-0 py-3"><div class="d-flex justify-content-between gap-3"><div><div class="fw-semibold mb-2">@question.QuestionText</div><div class="small text-muted">Correct answer: <span class="fw-semibold">@question.CorrectAnswer</span></div></div><div class="btn-group btn-group-sm align-self-start"><a asp-action="EditQuestion" asp-route-id="@question.Id" class="btn btn-outline-primary" title="Edit question"><i class="bi bi-pencil"></i></a><a asp-action="DeleteQuestion" asp-route-id="@question.Id" class="btn btn-outline-danger" title="Delete question"><i class="bi bi-trash"></i></a></div></div></div>}</div> } else { <div class="text-center py-4 text-muted"><i class="bi bi-list-check fs-2 d-block mb-2"></i>No questions have been added yet.</div> }
        </div></div></div></div>
    <div class="mt-4"><a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i>Back to Quizzes</a></div>
</div>
