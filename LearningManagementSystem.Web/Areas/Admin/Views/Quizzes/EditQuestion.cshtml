@model UpdateQuestionDto
@{
    ViewData["Title"] = "Edit Question";
}

<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-9"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5">
    <h1 class="h3 fw-bold mb-1">Edit Question</h1><p class="text-muted mb-4">Update the question, its options, or the correct answer.</p>
    <form asp-action="EditQuestion" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><input asp-for="QuizId" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3"><label asp-for="QuestionText" class="form-label fw-semibold"></label><textarea asp-for="QuestionText" class="form-control" rows="3"></textarea><span asp-validation-for="QuestionText" class="text-danger small"></span></div>
        <div class="row g-3"><div class="col-md-6"><label asp-for="OptionA" class="form-label fw-semibold"></label><input asp-for="OptionA" class="form-control" /><span asp-validation-for="OptionA" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="OptionB" class="form-label fw-semibold"></label><input asp-for="OptionB" class="form-control" /><span asp-validation-for="OptionB" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="OptionC" class="form-label fw-semibold"></label><input asp-for="OptionC" class="form-control" /><span asp-validation-for="OptionC" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="OptionD" class="form-label fw-semibold"></label><input asp-for="OptionD" class="form-control" /><span asp-validation-for="OptionD" class="text-danger small"></span></div></div>
        <div class="mt-3"><label asp-for="CorrectAnswer" class="form-label fw-semibold"></label><select asp-for="CorrectAnswer" class="form-select"><option value="OptionA">Option A</option><option value="OptionB">Option B</option><option value="OptionC">Option C</option><option value="OptionD">Option D</option></select><span asp-validation-for="CorrectAnswer" class="text-danger small"></span></div>
        <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Details" asp-route-id="@Model.QuizId" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Question</button></div>
    </form>
</div></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
