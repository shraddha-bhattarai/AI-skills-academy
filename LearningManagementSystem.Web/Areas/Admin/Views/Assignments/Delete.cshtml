@model AssignmentDto
@{
    ViewData["Title"] = "Delete Assignment";
}

@section Styles {
<style>
    .delete-card {
        background: #fff; border-radius: var(--lms-radius, 16px); padding: 2.25rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.05);
    }

    .delete-header { border-bottom: 1px solid #edf2f7; padding-bottom: 1.25rem; margin-bottom: 1.5rem; }
    .delete-header h2 { font-weight: 700; font-size: 1.5rem; color: #dc2626; margin-bottom: 0.25rem; }

    .delete-warning {
        background: #fef2f2; border: 1px solid #fee2e2; border-radius: 12px;
        padding: 1.25rem; color: #991b1b; margin-bottom: 1.75rem;
        display: flex; align-items: flex-start; gap: 1rem;
    }
    .delete-warning i { font-size: 1.5rem; line-height: 1; flex-shrink: 0; }

    .summary-box { background: #f8fafc; border-radius: 12px; padding: 1.5rem; border: 1px solid #edf2f7; margin-bottom: 1.75rem; }
    .summary-row { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid #edf2f7; font-size: 0.92rem; }
    .summary-row:last-child { border-bottom: none; padding-bottom: 0; }
    .summary-label { font-weight: 600; color: var(--lms-muted, #6a6f73); }
    .summary-value { font-weight: 600; color: var(--lms-dark, #1c1d1f); }

    .btn-delete-confirm {
        background: #dc2626; color: #fff; font-weight: 600; border-radius: 10px;
        padding: 0.7rem 1.8rem; border: none;
        box-shadow: 0 4px 14px rgba(220,38,38,0.25); transition: all 0.2s ease;
    }
    .btn-delete-confirm:hover { background: #b91c1c; color: #fff; transform: translateY(-2px); }

    .btn-cancel {
        background: #f1f5f9; color: var(--lms-muted, #6a6f73); font-weight: 600;
        border-radius: 10px; padding: 0.7rem 1.5rem; border: none;
        text-decoration: none; transition: all 0.2s ease; display: inline-flex; align-items: center;
    }
    .btn-cancel:hover { background: #e2e8f0; color: var(--lms-dark, #1c1d1f); }
</style>
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size:0.85rem;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Assignments" asp-action="Index" class="text-decoration-none text-muted">Assignments</a></li>
            <li class="breadcrumb-item active text-danger fw-semibold" aria-current="page">Delete Assignment</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="delete-card">
                <div class="delete-header">
                    <h2><i class="bi bi-file-earmark-x-fill me-2"></i>Delete Assignment</h2>
                    <p class="text-muted mb-0">Review the assignment details before permanently removing it from the system.</p>
                </div>

                <div class="delete-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        <strong>Warning:</strong> Deleting this assignment will soft-delete it from the system. Student submissions associated with this assignment will be preserved but the assignment will no longer be visible to students.
                    </div>
                </div>

                <div class="summary-box">
                    <div class="summary-row">
                        <span class="summary-label">Assignment Title</span>
                        <span class="summary-value">@Model.Title</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Course</span>
                        <span class="summary-value">@Model.CourseTitle</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Due Date</span>
                        <span class="summary-value">@Model.DueDate.ToString("MMM d, yyyy 'at' h:mm tt")</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Status</span>
                        <span class="summary-value">@Model.Status</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Created</span>
                        <span class="summary-value">@Model.CreatedAt.ToString("MMM d, yyyy")</span>
                    </div>
                </div>

                <form asp-area="Admin" asp-controller="Assignments" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <a asp-area="Admin" asp-controller="Assignments" asp-action="Index" class="btn btn-cancel">
                            <i class="bi bi-x-lg me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-delete-confirm">
                            <i class="bi bi-trash me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
