@model AssignmentDto
@{
    ViewData["Title"] = "Assignment Details";

    var statusClass = Model.Status switch
    {
        AssignmentStatus.Draft     => "status-draft",
        AssignmentStatus.Published => "status-published",
        AssignmentStatus.Closed    => "status-closed",
        _                          => "status-draft"
    };

    var isOverdue = Model.DueDate < DateTime.UtcNow && Model.Status != AssignmentStatus.Closed;
}

@section Styles {
<style>
    .details-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 50%, #4c1d95 100%);
        border-radius: var(--lms-radius, 16px);
        padding: 2.5rem 2rem; color: #fff; position: relative; overflow: hidden;
        margin-bottom: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    .details-hero::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(164,53,240,0.25) 0%, transparent 60%);
    }

    .details-card {
        background: #fff; border-radius: var(--lms-radius, 16px); padding: 2rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.05); height: 100%;
    }

    .meta-box {
        background: #f8fafc; border-radius: 12px; padding: 1.25rem; border: 1px solid #edf2f7; margin-bottom: 1rem;
    }

    .meta-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--lms-muted, #6a6f73); margin-bottom: 0.25rem; }
    .meta-value { font-size: 1rem; font-weight: 700; color: var(--lms-dark, #1c1d1f); }

    .status-badge { font-size: 0.8rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 50px; }
    .status-draft     { background: rgba(107,114,128,0.12); color: #4b5563; }
    .status-published { background: rgba(16,185,129,0.14); color: #059669; }
    .status-closed    { background: rgba(245,87,108,0.12); color: #c93357; }

    .description-card { background: #f8fafc; border-radius: 12px; padding: 1.5rem; border: 1px solid #edf2f7; line-height: 1.7; color: var(--lms-dark, #1c1d1f); font-size: 0.92rem; }

    .overdue-badge { background: #dc2626; color: #fff; font-size: 0.7rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 50px; }
</style>
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size:0.85rem;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Assignments" asp-action="Index" class="text-decoration-none text-muted">Assignments</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Assignment #@Model.Id</li>
        </ol>
    </nav>

    @* ── Header Hero ── *@
    <div class="details-hero">
        <div class="position-relative">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="status-badge @statusClass" style="font-size:0.75rem;">@Model.Status</span>
                <span class="badge rounded-pill bg-white text-dark px-3 py-1 fw-bold" style="font-size:0.73rem;">
                    <i class="bi bi-journal-bookmark text-primary me-1"></i> @Model.CourseTitle
                </span>
                @if (isOverdue)
                {
                    <span class="overdue-badge"><i class="bi bi-exclamation-circle me-1"></i> Overdue</span>
                }
            </div>
            <h1 class="fw-bold mb-2">@Model.Title</h1>
            <p class="opacity-75 mb-0"><i class="bi bi-calendar3 me-1"></i> Due @Model.DueDate.ToString("MMMM d, yyyy 'at' h:mm tt")</p>
        </div>
    </div>

    <div class="row g-4">
        @* ── Description & Course ── *@
        <div class="col-lg-8">
            <div class="details-card mb-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-card-text text-primary me-2"></i>Description</h5>
                <div class="description-card">@Model.Description</div>
            </div>

            <div class="details-card">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-journal-text text-primary me-2"></i>Course</h5>
                <div class="meta-box mb-0">
                    <div class="meta-label">Linked Course</div>
                    <div class="meta-value d-flex align-items-center gap-2">
                        <i class="bi bi-journal-bookmark-fill text-primary"></i> @Model.CourseTitle
                    </div>
                    <div class="small text-muted mt-1">Course ID: @Model.CourseId</div>
                </div>
            </div>
        </div>

        @* ── Sidebar ── *@
        <div class="col-lg-4">
            <div class="details-card d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Details</h5>

                    <div class="meta-box">
                        <div class="meta-label">Status</div>
                        <div class="meta-value"><span class="status-badge @statusClass">@Model.Status</span></div>
                    </div>

                    <div class="meta-box">
                        <div class="meta-label">Due Date</div>
                        <div class="meta-value @(isOverdue ? "text-danger" : "")">
                            @Model.DueDate.ToString("MMM d, yyyy")
                            <div class="fw-normal small">@Model.DueDate.ToString("h:mm tt")</div>
                        </div>
                    </div>

                    <div class="meta-box">
                        <div class="meta-label">Created</div>
                        <div class="meta-value" style="font-size:0.95rem;">@Model.CreatedAt.ToString("MMM d, yyyy")</div>
                    </div>
                </div>

                <div class="pt-3 border-top d-flex flex-column gap-2">
                    <a asp-area="Admin" asp-controller="Assignments" asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-primary w-100 fw-semibold" style="background:var(--lms-gradient);border:none;border-radius:10px;padding:0.65rem;">
                        <i class="bi bi-pencil-square me-1"></i> Edit Assignment
                    </a>
                    <a asp-area="Admin" asp-controller="Assignments" asp-action="Delete" asp-route-id="@Model.Id"
                       class="btn btn-outline-danger w-100 fw-semibold" style="border-radius:10px;padding:0.65rem;">
                        <i class="bi bi-trash me-1"></i> Delete Assignment
                    </a>
                    <a asp-area="Admin" asp-controller="Assignments" asp-action="Index"
                       class="btn btn-light w-100 text-muted fw-semibold" style="border-radius:10px;padding:0.65rem;">
                        <i class="bi bi-arrow-left me-1"></i> Back to Assignments
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
