@model LearningManagementSystem.Web.Areas.Admin.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

@* ─── Inline dashboard styles ──────────────────────────────────────────── *@
@section Styles {
<style>
/* ── Admin Dashboard Wrapper ──────────────────────────────────────── */
.admin-dashboard {
    font-family: 'Poppins', sans-serif;
    min-height: 100vh;
    background: #f7f9fa;
    padding-top: var(--lms-nav-height, 76px);
}

/* ── Hero / Header ────────────────────────────────────────────────── */
.admin-hero {
    background: var(--lms-gradient, linear-gradient(135deg,#5624d0,#7c3aed,#a435f0));
    padding: 3rem 0 4rem;
    color: #fff;
    position: relative;
    overflow: hidden;
    border-radius: 0 0 28px 28px;
}
.admin-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.admin-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 1rem;
    backdrop-filter: blur(8px);
}
.admin-hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 0.75rem;
}
.admin-hero h1 .highlight {
    background: linear-gradient(90deg, #ffd700, #ffb347);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
.admin-hero p {
    font-size: 1.05rem;
    opacity: 0.9;
    max-width: 540px;
}
.admin-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
}
.admin-hero-meta span {
    font-size: 0.875rem;
    opacity: 0.85;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

/* ── Stat Cards ───────────────────────────────────────────────────── */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-top: -2.5rem;
    padding: 0 1rem;
}
.stat-card {
    background: #fff;
    border-radius: 20px;
    padding: 1.5rem 1.25rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    transition: all 0.3s cubic-bezier(.4,0,.2,1);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.04);
}
.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(86,36,208,0.15);
}
.stat-card::after {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 5px; height: 100%;
    border-radius: 0 20px 20px 0;
}
.stat-card.c-purple::after  { background: linear-gradient(180deg,#5624d0,#7c3aed); }
.stat-card.c-green::after   { background: linear-gradient(180deg,#43e97b,#38f9d7); }
.stat-card.c-blue::after    { background: linear-gradient(180deg,#667eea,#764ba2); }
.stat-card.c-orange::after  { background: linear-gradient(180deg,#fa709a,#fee140); }
.stat-card.c-pink::after    { background: linear-gradient(180deg,#f093fb,#f5576c); }
.stat-card.c-teal::after    { background: linear-gradient(180deg,#4facfe,#00f2fe); }
.stat-card.c-indigo::after  { background: linear-gradient(180deg,#5ee7df,#b490ca); }
.stat-card.c-red::after     { background: linear-gradient(180deg,#fc5c7d,#6a3093); }

.stat-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.35rem;
    margin-bottom: 1rem;
}
.stat-card.c-purple  .stat-icon { background: linear-gradient(135deg,#5624d0,#7c3aed); color:#fff; }
.stat-card.c-green   .stat-icon { background: linear-gradient(135deg,#43e97b,#38f9d7); color:#fff; }
.stat-card.c-blue    .stat-icon { background: linear-gradient(135deg,#667eea,#764ba2); color:#fff; }
.stat-card.c-orange  .stat-icon { background: linear-gradient(135deg,#fa709a,#fee140); color:#fff; }
.stat-card.c-pink    .stat-icon { background: linear-gradient(135deg,#f093fb,#f5576c); color:#fff; }
.stat-card.c-teal    .stat-icon { background: linear-gradient(135deg,#4facfe,#00f2fe); color:#fff; }
.stat-card.c-indigo  .stat-icon { background: linear-gradient(135deg,#5ee7df,#b490ca); color:#fff; }
.stat-card.c-red     .stat-icon { background: linear-gradient(135deg,#fc5c7d,#6a3093); color:#fff; }

.stat-value {
    font-size: 2rem;
    font-weight: 800;
    color: var(--lms-dark, #1c1d1f);
    line-height: 1;
    margin-bottom: 0.25rem;
}
.stat-label {
    font-size: 0.8rem;
    color: var(--lms-muted, #6a6f73);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ── Section wrapper ─────────────────────────────────────────────── */
.dash-section {
    padding: 2.5rem 0;
}
.dash-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
}
.dash-section-header h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--lms-dark, #1c1d1f);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.dash-section-header h2 .section-icon {
    width: 34px; height: 34px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.95rem;
    color: #fff;
}
.view-all-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--lms-primary, #5624d0);
    text-decoration: none;
    display: flex; align-items: center; gap: 0.3rem;
    transition: gap 0.2s;
}
.view-all-link:hover { gap: 0.6rem; }

/* ── Data Cards ──────────────────────────────────────────────────── */
.data-card {
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
    overflow: hidden;
}
.data-card .table {
    margin: 0;
    font-size: 0.875rem;
}
.data-card .table th {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    color: var(--lms-muted, #6a6f73);
    border-bottom: 1px solid #f0f0f0;
    padding: 0.9rem 1.25rem;
    white-space: nowrap;
}
.data-card .table td {
    padding: 0.85rem 1.25rem;
    vertical-align: middle;
    border-bottom: 1px solid #f8f8f8;
    color: var(--lms-dark, #1c1d1f);
}
.data-card .table tbody tr:last-child td { border-bottom: none; }
.data-card .table tbody tr:hover td { background: #fafafa; }

/* ── Quick Action Cards ──────────────────────────────────────────── */
.quick-actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
}
.quick-action-card {
    background: #fff;
    border-radius: 18px;
    padding: 1.5rem 1rem;
    text-align: center;
    text-decoration: none;
    border: 2px solid transparent;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    transition: all 0.3s cubic-bezier(.4,0,.2,1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
}
.quick-action-card:hover {
    border-color: var(--lms-primary, #5624d0);
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(86,36,208,0.15);
    text-decoration: none;
}
.qa-icon {
    width: 54px; height: 54px;
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
    color: #fff;
}
.quick-action-card span {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--lms-dark, #1c1d1f);
}

/* ── Avatar initials ─────────────────────────────────────────────── */
.avatar-initials {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
}

/* ── Empty state ─────────────────────────────────────────────────── */
.empty-state {
    text-align: center;
    padding: 2.5rem 1rem;
    color: var(--lms-muted, #6a6f73);
}
.empty-state i { font-size: 2rem; opacity: 0.4; display: block; margin-bottom: 0.5rem; }
.empty-state p { font-size: 0.875rem; margin: 0; }
</style>
}

<div class="admin-dashboard">

    @* ─── HERO ──────────────────────────────────────────────────────────── *@
    <section class="admin-hero">
        <div class="container position-relative">
            <div class="admin-hero-badge">
                <i class="bi bi-shield-lock-fill"></i> Admin Portal
            </div>
            <h1>
                Welcome back, <span class="highlight">@Model.AdminName</span>!
            </h1>
            <p>Manage AI Skills Academy, monitor learning activity, and keep your platform running smoothly.</p>
            <div class="admin-hero-meta">
                <span><i class="bi bi-people-fill"></i> @Model.TotalStudents Students</span>
                <span><i class="bi bi-collection-fill"></i> @Model.TotalCourses Courses</span>
                <span><i class="bi bi-award-fill"></i> @Model.TotalCertificates Certificates</span>
                <span><i class="bi bi-hourglass-split"></i> @Model.PendingSubmissions Pending Reviews</span>
            </div>
        </div>
    </section>

    @* ─── STATISTICS GRID ───────────────────────────────────────────────── *@
    <div class="container">
        <div class="stats-grid">
            <div class="stat-card c-purple">
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="stat-value">@Model.TotalStudents</div>
                <div class="stat-label">Total Students</div>
            </div>
            <div class="stat-card c-green">
                <div class="stat-icon"><i class="bi bi-collection-fill"></i></div>
                <div class="stat-value">@Model.TotalCourses</div>
                <div class="stat-label">Total Courses</div>
            </div>
            <div class="stat-card c-blue">
                <div class="stat-icon"><i class="bi bi-grid-3x3-gap-fill"></i></div>
                <div class="stat-value">@Model.TotalCategories</div>
                <div class="stat-label">Categories</div>
            </div>
            <div class="stat-card c-orange">
                <div class="stat-icon"><i class="bi bi-person-check-fill"></i></div>
                <div class="stat-value">@Model.TotalEnrollments</div>
                <div class="stat-label">Enrollments</div>
            </div>
            <div class="stat-card c-pink">
                <div class="stat-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                <div class="stat-value">@Model.TotalAssignments</div>
                <div class="stat-label">Assignments</div>
            </div>
            <div class="stat-card c-teal">
                <div class="stat-icon"><i class="bi bi-patch-question-fill"></i></div>
                <div class="stat-value">@Model.TotalQuizzes</div>
                <div class="stat-label">Quizzes</div>
            </div>
            <div class="stat-card c-indigo">
                <div class="stat-icon"><i class="bi bi-award-fill"></i></div>
                <div class="stat-value">@Model.TotalCertificates</div>
                <div class="stat-label">Certificates</div>
            </div>
            <div class="stat-card c-red">
                <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-value">@Model.PendingSubmissions</div>
                <div class="stat-label">Pending Reviews</div>
            </div>
        </div>
    </div>

    @* ─── QUICK ACTIONS ─────────────────────────────────────────────────── *@
    <section class="dash-section">
        <div class="container">
            <div class="dash-section-header">
                <h2>
                    <span class="section-icon" style="background:var(--lms-gradient)">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </span>
                    Quick Actions
                </h2>
            </div>
            <div class="quick-actions-grid">
                <a asp-area="Admin" asp-controller="Courses" asp-action="Create" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#5624d0,#7c3aed)">
                        <i class="bi bi-plus-circle-fill"></i>
                    </div>
                    <span>New Course</span>
                </a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#43e97b,#38f9d7)">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                    <span>New Category</span>
                </a>
                <a asp-area="Admin" asp-controller="Assignments" asp-action="Create" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#fa709a,#fee140)">
                        <i class="bi bi-file-earmark-plus-fill"></i>
                    </div>
                    <span>New Assignment</span>
                </a>
                <a asp-area="Admin" asp-controller="Quizzes" asp-action="Create" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#4facfe,#00f2fe)">
                        <i class="bi bi-patch-plus-fill"></i>
                    </div>
                    <span>New Quiz</span>
                </a>
                <a asp-area="Admin" asp-controller="Courses" asp-action="Index" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#667eea,#764ba2)">
                        <i class="bi bi-collection-fill"></i>
                    </div>
                    <span>Manage Courses</span>
                </a>
                <a asp-area="Admin" asp-controller="Enrollments" asp-action="Index" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#f093fb,#f5576c)">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                    <span>Enrollments</span>
                </a>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#2563eb,#0ea5e9)">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span>Manage Users</span>
                </a>
                <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#16a34a,#10b981)">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                    <span>View Reports</span>
                </a>
                <a asp-area="Admin" asp-controller="Submissions" asp-action="Index" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#fc5c7d,#6a3093)">
                        <i class="bi bi-inbox-fill"></i>
                    </div>
                    <span>Submissions</span>
                </a>
                <a asp-area="Admin" asp-controller="Certificates" asp-action="Index" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#5ee7df,#b490ca)">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <span>Certificates</span>
                </a>
                <a asp-area="Admin" asp-controller="Notifications" asp-action="Index" class="quick-action-card">
                    <div class="qa-icon" style="background:linear-gradient(135deg,#ffecd2,#fcb69f)">
                        <i class="bi bi-bell-fill" style="color:#1c1d1f"></i>
                    </div>
                    <span>Notifications</span>
                </a>
            </div>
        </div>
    </section>

    @* ─── RECENT COURSES + RECENT STUDENTS ─────────────────────────────── *@
    <div class="container">
        <div class="row g-4">

            @* Recent Courses *@
            <div class="col-lg-7">
                <div class="dash-section-header">
                    <h2>
                        <span class="section-icon" style="background:linear-gradient(135deg,#5624d0,#7c3aed)">
                            <i class="bi bi-collection-fill"></i>
                        </span>
                        Recent Courses
                    </h2>
                    <a asp-area="Admin" asp-controller="Courses" asp-action="Index" class="view-all-link">
                        View all <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="data-card">
                    @if (Model.RecentCourses.Any())
                    {
                        <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th class="text-end">Enrollments</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.RecentCourses)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                                 title="@c.Title">@c.Title</div>
                                            <div class="text-muted" style="font-size:0.75rem">
                                                @c.CreatedAt.ToString("MMM d, yyyy")
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1 rounded-pill">
                                                @c.Category
                                            </span>
                                        </td>
                                        <td><span class="badge @c.StatusBadge rounded-pill px-2">@c.Status</span></td>
                                        <td class="text-end fw-semibold">@c.Enrollments</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-collection"></i>
                            <p>No courses yet. <a asp-area="Admin" asp-controller="Courses" asp-action="Create">Create the first one.</a></p>
                        </div>
                    }
                </div>
            </div>

            @* Recent Students *@
            <div class="col-lg-5">
                <div class="dash-section-header">
                    <h2>
                        <span class="section-icon" style="background:linear-gradient(135deg,#43e97b,#38f9d7)">
                            <i class="bi bi-people-fill"></i>
                        </span>
                        Recent Students
                    </h2>
                </div>
                <div class="data-card">
                    @if (Model.RecentStudents.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var s in Model.RecentStudents)
                            {
                                var initials = string.Concat(
                                    (s.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                               .Select(p => p[0].ToString()))
                                    .Take(2)).ToUpper();
                                if (string.IsNullOrWhiteSpace(initials)) initials = "S";
                                var colors = new[]{"#5624d0","#43e97b","#fa709a","#4facfe","#f093fb","#fc5c7d"};
                                var color = colors[Math.Abs(s.Email.GetHashCode()) % colors.Length];

                                <li class="d-flex align-items-center gap-3 px-4 py-3 border-bottom" style="border-color:#f8f8f8 !important">
                                    <div class="avatar-initials" style="background:@color">@initials</div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="font-size:0.875rem">
                                            @(string.IsNullOrWhiteSpace(s.FullName) ? s.Email : s.FullName)
                                        </div>
                                        <div class="text-muted text-truncate" style="font-size:0.75rem">@s.Email</div>
                                    </div>
                                    <span class="badge @(s.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill" style="font-size:0.7rem">
                                        @(s.IsActive ? "Active" : "Inactive")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-people"></i>
                            <p>No students registered yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ─── RECENT ENROLLMENTS + RECENT CERTIFICATES ─────────────────────── *@
    <div class="container">
        <div class="row g-4 pb-5 mt-0">

            @* Recent Enrollments *@
            <div class="col-lg-6">
                <div class="dash-section-header">
                    <h2>
                        <span class="section-icon" style="background:linear-gradient(135deg,#fa709a,#fee140)">
                            <i class="bi bi-person-check-fill"></i>
                        </span>
                        Recent Enrollments
                    </h2>
                    <a asp-area="Admin" asp-controller="Enrollments" asp-action="Index" class="view-all-link">
                        View all <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="data-card">
                    @if (Model.RecentEnrollments.Any())
                    {
                        <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Date</th>
                                    <th class="text-end">Progress</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.RecentEnrollments)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-truncate" style="max-width:180px" title="@e.CourseTitle">
                                                @e.CourseTitle
                                            </div>
                                        </td>
                                        <td class="text-muted" style="white-space:nowrap;font-size:0.8rem">
                                            @e.EnrolledOn.ToString("MMM d, yyyy")
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex align-items-center gap-2 justify-content-end">
                                                <div class="progress flex-grow-1" style="height:6px;border-radius:50px;max-width:70px">
                                                    <div class="progress-bar" style="width:@e.Progress%;background:var(--lms-gradient);border-radius:50px"></div>
                                                </div>
                                                <span style="font-size:0.75rem;font-weight:600;color:var(--lms-primary)">@e.Progress%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-person-check"></i>
                            <p>No enrollments yet.</p>
                        </div>
                    }
                </div>
            </div>

            @* Recent Certificates *@
            <div class="col-lg-6">
                <div class="dash-section-header">
                    <h2>
                        <span class="section-icon" style="background:linear-gradient(135deg,#5ee7df,#b490ca)">
                            <i class="bi bi-award-fill"></i>
                        </span>
                        Recent Certificates
                    </h2>
                    <a asp-area="Admin" asp-controller="Certificates" asp-action="Index" class="view-all-link">
                        View all <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="data-card">
                    @if (Model.RecentCertificates.Any())
                    {
                        <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Issued</th>
                                    <th>Cert #</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cert in Model.RecentCertificates)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-truncate" style="max-width:160px" title="@cert.CourseTitle">
                                                @cert.CourseTitle
                                            </div>
                                        </td>
                                        <td class="text-muted" style="white-space:nowrap;font-size:0.8rem">
                                            @cert.IssuedDate.ToString("MMM d, yyyy")
                                        </td>
                                        <td>
                                            <code style="font-size:0.7rem;background:#f7f9fa;padding:2px 6px;border-radius:6px">
                                                @cert.CertNumber[..Math.Min(8, cert.CertNumber.Length)]…
                                            </code>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-award"></i>
                            <p>No certificates issued yet.</p>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

</div>
