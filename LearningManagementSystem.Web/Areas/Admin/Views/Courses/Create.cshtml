@model CreateCourseDto
@{
    ViewData["Title"] = "Create Course";
}

@section Styles {
<style>
    .form-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        padding: 2.25rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .form-header {
        border-bottom: 1px solid #edf2f7;
        padding-bottom: 1.25rem;
        margin-bottom: 1.75rem;
    }

    .form-header h2 {
        font-weight: 700;
        font-size: 1.5rem;
        color: var(--lms-dark, #1c1d1f);
        margin-bottom: 0.25rem;
    }

    .form-header p {
        color: var(--lms-muted, #6a6f73);
        font-size: 0.9rem;
        margin: 0;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.88rem;
        color: var(--lms-dark, #1c1d1f);
        margin-bottom: 0.4rem;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 0.65rem 1rem;
        font-size: 0.92rem;
        border: 1px solid #cbd5e1;
        transition: var(--lms-transition, all 0.2s ease);
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--lms-primary, #5624d0);
        box-shadow: 0 0 0 3px rgba(86, 36, 208, 0.15);
    }

    .btn-submit {
        background: var(--lms-gradient, linear-gradient(135deg, #5624d0, #7c3aed));
        color: #fff;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.7rem 1.8rem;
        border: none;
        box-shadow: 0 4px 14px rgba(86, 36, 208, 0.25);
        transition: var(--lms-transition, all 0.3s ease);
    }

    .btn-submit:hover {
        opacity: 0.92;
        color: #fff;
        transform: translateY(-2px);
    }

    .btn-cancel {
        background: #f1f5f9;
        color: var(--lms-muted, #6a6f73);
        font-weight: 600;
        border-radius: 10px;
        padding: 0.7rem 1.5rem;
        border: none;
        text-decoration: none;
        transition: var(--lms-transition, all 0.2s ease);
        display: inline-flex;
        align-items: center;
    }

    .btn-cancel:hover {
        background: #e2e8f0;
        color: var(--lms-dark, #1c1d1f);
    }

    .thumb-preview-box {
        width: 100%;
        height: 160px;
        border-radius: 12px;
        border: 2px dashed #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f8fafc;
        overflow: hidden;
        position: relative;
    }

    .thumb-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Courses" asp-action="Index" class="text-decoration-none text-muted">Courses</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Create Course</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="form-card">
                <div class="form-header">
                    <h2><i class="bi bi-plus-circle-fill text-primary me-2"></i>Create New Course</h2>
                    <p>Enter the details below to publish or draft a new course in the catalog.</p>
                </div>

                <form asp-area="Admin" asp-controller="Courses" asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Master ASP.NET Core & Clean Architecture" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Provide a comprehensive description of the course content, outcomes, and objectives..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="LearningOutcomes" class="form-label"></label>
                            <textarea asp-for="LearningOutcomes" class="form-control" rows="4" placeholder="One outcome per line, e.g. Build production-ready ASP.NET Core APIs..."></textarea>
                            <span asp-validation-for="LearningOutcomes" class="text-danger small"></span>
                            <div class="form-text small text-muted">Shown to learners on the public course details page.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">$</span>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Level" class="form-label"></label>
                            <select asp-for="Level" asp-items="Html.GetEnumSelectList<CourseLevel>()" class="form-select"></select>
                            <span asp-validation-for="Level" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<CourseStatus>()" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ThumbnailUrl" class="form-label"></label>
                            <input asp-for="ThumbnailUrl" id="thumbnailUrlInput" class="form-control" placeholder="https://images.unsplash.com/photo-..." />
                            <span asp-validation-for="ThumbnailUrl" class="text-danger small"></span>
                            <div class="form-text small text-muted">Provide a valid image URL for the course thumbnail.</div>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top d-flex align-items-center justify-content-end gap-2">
                            <a asp-area="Admin" asp-controller="Courses" asp-action="Index" class="btn btn-cancel">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-submit">
                                <i class="bi bi-check-lg me-1"></i> Create Course
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
