@model IReadOnlyList<QuizResultReportItemViewModel>
@{
    ViewData["Title"] = "Quiz Results Report";
    var quizzes = ViewBag.Quizzes as IReadOnlyList<LookupItemDto> ?? new List<LookupItemDto>();
    var quizId = ViewBag.QuizId as int?;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Reports" asp-action="Index">Reports</a></li>
            <li class="breadcrumb-item active">Quiz Results</li>
        </ol>
    </nav>

    <h1><i class="bi bi-patch-question me-2"></i>Quiz Results Report</h1>

    <form method="get" asp-area="Admin" asp-controller="Reports" asp-action="QuizResults" class="row g-2 mb-3 mt-2">
        <div class="col-md-4">
            <select name="quizId" class="form-select" onchange="this.form.submit()">
                <option value="">All Quizzes</option>
                @foreach (var q in quizzes)
                {
                    <option value="@q.Id" selected="@(quizId?.ToString() == q.Id)">@q.Name</option>
                }
            </select>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white rounded shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Quiz</th>
                    <th>Course</th>
                    <th>Total Attempts</th>
                    <th>Pass Rate</th>
                    <th>Average Score</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No quizzes found.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.QuizTitle</td>
                        <td>@item.CourseTitle</td>
                        <td>@item.TotalAttempts</td>
                        <td>
                            @if (item.TotalAttempts > 0)
                            {
                                <span class="badge @(item.PassRatePercent >= 50 ? "bg-success" : "bg-danger")">@item.PassRatePercent.ToString("0.#")%</span>
                                <span class="text-muted small">(@item.PassCount / @item.TotalAttempts passed)</span>
                            }
                            else
                            {
                                <span class="text-muted">No attempts yet</span>
                            }
                        </td>
                        <td>@(item.TotalAttempts > 0 ? item.AverageScorePercent.ToString("0.#") + "%" : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
