@model IReadOnlyList<EnrollmentReportItemViewModel>
@{
    ViewData["Title"] = "Enrollment Report";
    var courses = ViewBag.Courses as IReadOnlyList<LookupItemDto> ?? new List<LookupItemDto>();
    var courseId = ViewBag.CourseId as int?;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Reports" asp-action="Index">Reports</a></li>
            <li class="breadcrumb-item active">Enrollments</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h1><i class="bi bi-person-check me-2"></i>Enrollment Report</h1>
        <div class="text-muted">
            <strong>@ViewBag.TotalCount</strong> total &middot; <strong>@ViewBag.CompletedCount</strong> completed (100%)
        </div>
    </div>

    <form method="get" asp-area="Admin" asp-controller="Reports" asp-action="Enrollments" class="row g-2 mb-3">
        <div class="col-md-4">
            <select name="courseId" class="form-select" onchange="this.form.submit()">
                <option value="">All Courses</option>
                @foreach (var c in courses)
                {
                    <option value="@c.Id" selected="@(courseId?.ToString() == c.Id)">@c.Name</option>
                }
            </select>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white rounded shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Enrolled On</th>
                    <th>Progress</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No enrollments found.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.StudentName <div class="text-muted small">@item.StudentEmail</div></td>
                        <td>@item.CourseTitle</td>
                        <td>@item.EnrollmentDate.ToString("MMM d, yyyy")</td>
                        <td style="min-width: 140px;">
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @(item.IsCompleted ? "bg-success" : "bg-primary")" style="width: @item.Progress%;"></div>
                            </div>
                            <span class="small text-muted">@item.Progress.ToString("0.#")%</span>
                        </td>
                        <td>
                            @if (item.IsCompleted)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">In Progress</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
