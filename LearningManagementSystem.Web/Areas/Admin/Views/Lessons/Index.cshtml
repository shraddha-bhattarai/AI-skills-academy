@model PagedResult<LessonDto>
@{
    ViewData["Title"] = "Lessons";
    var search = ViewBag.Search as string;
    var sortBy = ViewBag.SortBy as string;
    var sortDescending = ViewBag.SortDescending is bool desc && desc;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="bi bi-play-circle me-2"></i>Lessons</h1>
        <a asp-area="Admin" asp-controller="Lessons" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Create New
        </a>
    </div>

    <form method="get" asp-area="Admin" asp-controller="Lessons" asp-action="Index" class="row g-2 mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search lessons..." />
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white rounded shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>
                        <a class="text-white text-decoration-none" asp-area="Admin" asp-controller="Lessons" asp-action="Index"
                           asp-route-sortBy="title"
                           asp-route-sortDescending="@(sortBy == "title" ? !sortDescending : false)"
                           asp-route-search="@search">
                            Title @(sortBy == "title" ? (sortDescending ? "▼" : "▲") : "")
                        </a>
                    </th>
                    <th>
                        <a class="text-white text-decoration-none" asp-area="Admin" asp-controller="Lessons" asp-action="Index"
                           asp-route-sortBy="course"
                           asp-route-sortDescending="@(sortBy == "course" ? !sortDescending : false)"
                           asp-route-search="@search">
                            Course @(sortBy == "course" ? (sortDescending ? "▼" : "▲") : "")
                        </a>
                    </th>
                    <th>
                        <a class="text-white text-decoration-none" asp-area="Admin" asp-controller="Lessons" asp-action="Index"
                           asp-route-sortBy="createdat"
                           asp-route-sortDescending="@(sortBy == "createdat" ? !sortDescending : false)"
                           asp-route-search="@search">
                            Created At @(sortBy == "createdat" ? (sortDescending ? "▼" : "▲") : "")
                        </a>
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.CourseTitle</td>
                        <td>@item.CreatedAt.ToString("g")</td>
                        <td class="text-end text-nowrap">
                            <a asp-area="Admin" asp-controller="Lessons" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-area="Admin" asp-controller="Lessons" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-area="Admin" asp-controller="Lessons" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="Model" />
</div>
