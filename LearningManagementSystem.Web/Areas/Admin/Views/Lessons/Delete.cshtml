@model LessonDto
@{
    ViewData["Title"] = "Delete Lesson";
}

<div class="container py-4">
    <h1><i class="bi bi-trash me-2"></i>Delete Lesson</h1>
    <hr />

    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Are you sure you want to delete this lesson? This action cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Model.CourseTitle</dd>
    </dl>

    <form asp-area="Admin" asp-controller="Lessons" asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i>Delete
        </button>
        <a asp-area="Admin" asp-controller="Lessons" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </a>
    </form>
</div>
