@model CertificateDto
@{
    ViewData["Title"] = "Certificate Details";
    var studentDisplay = string.IsNullOrWhiteSpace(Model.StudentName) ? Model.StudentId : Model.StudentName;
}

@section Styles {
<style>
    .details-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 50%, #4c1d95 100%);
        border-radius: var(--lms-radius, 16px);
        padding: 2.5rem 2rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .details-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(164, 53, 240, 0.25) 0%, transparent 60%);
    }

    .details-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        padding: 2rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
        height: 100%;
    }

    .meta-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid #edf2f7;
    }

    .meta-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--lms-muted, #6a6f73);
        margin-bottom: 0.25rem;
    }

    .meta-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--lms-dark, #1c1d1f);
    }
</style>
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Certificates" asp-action="Index" class="text-decoration-none text-muted">Certificates</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Certificate #@Model.Id</li>
        </ol>
    </nav>

    @* ── Header Hero ── *@
    <div class="details-hero">
        <div class="position-relative">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="badge rounded-pill bg-white text-dark px-3 py-1 fw-bold" style="font-size: 0.75rem;">
                    <i class="bi bi-award-fill text-primary me-1"></i> Certificate
                </span>
                <span class="badge rounded-pill bg-white text-dark px-3 py-1 fw-bold" style="font-size: 0.75rem;">
                    <i class="bi bi-journal-bookmark text-primary me-1"></i> @Model.CourseTitle
                </span>
            </div>
            <h1 class="fw-bold mb-2">@studentDisplay</h1>
            <p class="opacity-75 mb-0">
                Issued on @Model.IssuedDate.ToString("MMMM d, yyyy")
            </p>
        </div>
    </div>

    <div class="row g-4">
        @* ── Student & Certificate Info ── *@
        <div class="col-lg-8">
            <div class="details-card mb-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge-fill text-primary me-2"></i>Student Information</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="meta-box">
                            <div class="meta-label">Student Name</div>
                            <div class="meta-value" style="font-size: 1rem;">@studentDisplay</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="meta-box">
                            <div class="meta-label">Student ID</div>
                            <div class="meta-value" style="font-size: 0.88rem; font-family: monospace;">@Model.StudentId</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="details-card">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-award text-primary me-2"></i>Certificate Information</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="meta-box">
                            <div class="meta-label">Course Title</div>
                            <div class="meta-value" style="font-size: 1rem;">@Model.CourseTitle</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="meta-box">
                            <div class="meta-label">Certificate Number</div>
                            <div class="meta-value" style="font-size: 0.88rem; font-family: monospace;">@Model.CertificateNumber</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="meta-box">
                            <div class="meta-label">Issued Date</div>
                            <div class="meta-value" style="font-size: 1rem;">@Model.IssuedDate.ToString("MMMM d, yyyy")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="meta-box">
                            <div class="meta-label">Certificate ID</div>
                            <div class="meta-value" style="font-size: 1rem;">#@Model.Id</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Sidebar Actions ── *@
        <div class="col-lg-4">
            <div class="details-card d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-gear text-primary me-2"></i>Actions</h5>

                    <div class="meta-box mb-3">
                        <div class="meta-label">Course</div>
                        <div class="meta-value" style="font-size: 1rem;">
                            <i class="bi bi-journal-bookmark text-primary me-1"></i> @Model.CourseTitle
                        </div>
                    </div>

                    <div class="meta-box mb-4">
                        <div class="meta-label">Issued</div>
                        <div class="meta-value" style="font-size: 1rem;">
                            <i class="bi bi-calendar-check text-primary me-1"></i> @Model.IssuedDate.ToString("MMM d, yyyy")
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top d-flex flex-column gap-2">
                    <a asp-area="Admin" asp-controller="Certificates" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100 fw-semibold" style="border-radius: 10px; padding: 0.65rem;">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Download PDF
                    </a>
                    <a asp-area="Admin" asp-controller="Certificates" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary w-100 fw-semibold" style="background: var(--lms-gradient); border: none; border-radius: 10px; padding: 0.65rem;">
                        <i class="bi bi-pencil me-1"></i> Edit Certificate
                    </a>
                    <a asp-area="Admin" asp-controller="Certificates" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger w-100 fw-semibold" style="border-radius: 10px; padding: 0.65rem;">
                        <i class="bi bi-trash me-1"></i> Delete Certificate
                    </a>
                    <a asp-area="Admin" asp-controller="Certificates" asp-action="Index" class="btn btn-light w-100 text-muted fw-semibold" style="border-radius: 10px; padding: 0.65rem;">
                        <i class="bi bi-arrow-left me-1"></i> Back to Certificates
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
