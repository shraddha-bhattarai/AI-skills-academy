@model CertificateDto
@{
    ViewData["Title"] = "Delete Certificate";
    var studentDisplay = string.IsNullOrWhiteSpace(Model.StudentName) ? Model.StudentId : Model.StudentName;
}

@section Styles {
<style>
    .delete-hero {
        background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #b91c1c 100%);
        border-radius: var(--lms-radius, 16px);
        padding: 2.25rem 2rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(185, 28, 28, 0.15);
    }

    .delete-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(239, 68, 68, 0.25) 0%, transparent 60%);
    }

    .details-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        padding: 2rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .meta-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid #edf2f7;
    }

    .meta-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--lms-muted, #6a6f73);
        margin-bottom: 0.25rem;
    }

    .meta-value {
        font-size: 1rem;
        font-weight: 700;
        color: var(--lms-dark, #1c1d1f);
    }
</style>
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Certificates" asp-action="Index" class="text-decoration-none text-muted">Certificates</a></li>
            <li class="breadcrumb-item active text-danger fw-semibold" aria-current="page">Delete Certificate</li>
        </ol>
    </nav>

    @* ── Delete Warning Hero ── *@
    <div class="delete-hero">
        <div class="position-relative">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <span class="fw-bold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Confirm Deletion</span>
            </div>
            <h1 class="fw-bold mb-2" style="font-size: 1.85rem;">Delete Certificate</h1>
            <p class="opacity-90 mb-0">Are you sure you want to delete this certificate? This action cannot be undone.</p>
        </div>
    </div>

    <div class="details-card mb-4">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-award text-danger me-2"></i>Certificate Details</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="meta-box">
                    <div class="meta-label">Student</div>
                    <div class="meta-value">@studentDisplay</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="meta-box">
                    <div class="meta-label">Course</div>
                    <div class="meta-value">@Model.CourseTitle</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="meta-box">
                    <div class="meta-label">Certificate Number</div>
                    <div class="meta-value" style="font-family: monospace; font-size: 0.88rem;">@Model.CertificateNumber</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="meta-box">
                    <div class="meta-label">Issued Date</div>
                    <div class="meta-value">@Model.IssuedDate.ToString("MMMM d, yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <form asp-area="Admin" asp-controller="Certificates" asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger fw-semibold px-4" style="border-radius: 10px; padding: 0.65rem 1.5rem;">
                <i class="bi bi-trash me-1"></i> Yes, Delete Certificate
            </button>
        </form>
        <a asp-area="Admin" asp-controller="Certificates" asp-action="Index" class="btn btn-light text-muted fw-semibold" style="border-radius: 10px; padding: 0.65rem 1.5rem;">
            <i class="bi bi-x-circle me-1"></i> Cancel
        </a>
    </div>
</div>
