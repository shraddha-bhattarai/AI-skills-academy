@model IReadOnlyList<LearningManagementSystem.Web.Areas.Admin.ViewModels.AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Users";
    var search = ViewBag.Search as string;
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="bi bi-people me-2"></i>Users</h1>
    </div>

    <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="row g-2 mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by name or email..." />
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white rounded shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role(s)</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-primary bg-opacity-75 me-1">@role</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Deactivated</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info" title="Manage">
                                <i class="bi bi-gear"></i> Manage
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (var p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-page="@p" asp-route-search="@search">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
