@model PagedResult<CategoryDto>
@{
    ViewData["Title"] = "Categories";
    var search = ViewBag.Search as string;
    var sortBy = ViewBag.SortBy as string;
    var sortDescending = ViewBag.SortDescending is bool desc && desc;
}

@section Styles {
<style>
    .admin-categories-header {
        background: linear-gradient(135deg, #5624d0 0%, #7c3aed 50%, #a435f0 100%);
        border-radius: var(--lms-radius, 16px);
        padding: 2.25rem 2rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(86, 36, 208, 0.15);
    }

    .admin-categories-header::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .admin-categories-header h1 {
        font-weight: 800;
        font-size: 1.85rem;
        margin-bottom: 0.35rem;
    }

    .admin-categories-header p {
        opacity: 0.9;
        margin-bottom: 0;
        font-size: 0.95rem;
    }

    .btn-create-category {
        background: #fff;
        color: var(--lms-primary, #5624d0);
        font-weight: 700;
        border-radius: 12px;
        padding: 0.65rem 1.4rem;
        font-size: 0.9rem;
        border: none;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        transition: var(--lms-transition, all 0.3s ease);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .btn-create-category:hover {
        background: #f8f9fa;
        color: var(--lms-primary-dark, #401b9c);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    }

    .filter-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        padding: 1.25rem 1.5rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
        margin-bottom: 1.5rem;
    }

    .filter-card .form-control {
        border-radius: 10px;
        font-size: 0.9rem;
        padding: 0.55rem 0.9rem;
        border: 1px solid #e2e8f0;
    }

    .filter-card .form-control:focus {
        border-color: var(--lms-primary, #5624d0);
        box-shadow: 0 0 0 3px rgba(86, 36, 208, 0.15);
    }

    .btn-filter {
        background: var(--lms-gradient, linear-gradient(135deg, #5624d0, #7c3aed));
        color: #fff;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.55rem 1.25rem;
        border: none;
        transition: var(--lms-transition, all 0.3s ease);
    }

    .btn-filter:hover {
        opacity: 0.92;
        color: #fff;
        transform: translateY(-1px);
    }

    .btn-reset {
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.55rem 1rem;
        color: var(--lms-muted, #6a6f73);
        background: #f1f5f9;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-reset:hover {
        background: #e2e8f0;
        color: var(--lms-dark, #1c1d1f);
    }

    .table-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .categories-table {
        margin-bottom: 0;
    }

    .categories-table thead th {
        background: #f8fafc;
        color: var(--lms-muted, #6a6f73);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #edf2f7;
        white-space: nowrap;
    }

    .categories-table thead th a {
        color: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .categories-table thead th a:hover {
        color: var(--lms-primary, #5624d0);
    }

    .categories-table tbody td {
        padding: 1.1rem 1.25rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.88rem;
    }

    .categories-table tbody tr:last-child td {
        border-bottom: none;
    }

    .categories-table tbody tr:hover td {
        background-color: #fafbfc;
    }

    .category-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(86, 36, 208, 0.1), rgba(124, 58, 237, 0.15));
        color: var(--lms-primary, #5624d0);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .category-name-text {
        font-weight: 700;
        color: var(--lms-dark, #1c1d1f);
        font-size: 0.95rem;
    }

    .category-desc-text {
        color: var(--lms-muted, #6a6f73);
        font-size: 0.82rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .course-count-badge {
        background: rgba(86, 36, 208, 0.08);
        color: var(--lms-primary, #5624d0);
        font-weight: 600;
        padding: 0.35rem 0.85rem;
        border-radius: 50px;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .action-btn-group {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.4rem;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        text-decoration: none;
        transition: var(--lms-transition, all 0.2s ease);
        border: 1px solid transparent;
    }

    .action-btn-view {
        color: var(--lms-primary, #5624d0);
        background: rgba(86, 36, 208, 0.08);
    }

    .action-btn-view:hover {
        background: var(--lms-primary, #5624d0);
        color: #fff;
    }

    .action-btn-edit {
        color: #b57c00;
        background: rgba(250, 173, 20, 0.12);
    }

    .action-btn-edit:hover {
        background: #b57c00;
        color: #fff;
    }

    .action-btn-delete {
        color: #c93357;
        background: rgba(245, 87, 108, 0.12);
    }

    .action-btn-delete:hover {
        background: #c93357;
        color: #fff;
    }

    .empty-categories {
        text-align: center;
        padding: 4rem 1.5rem;
        color: var(--lms-muted, #6a6f73);
    }

    .empty-categories i {
        font-size: 3rem;
        color: #cbd5e1;
        display: block;
        margin-bottom: 1rem;
    }
</style>
}

<div class="container py-4">

    @* ── Header Banner ── *@
    <div class="admin-categories-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="position-relative">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill bg-white text-dark px-3 py-1 fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px; text-transform: uppercase;">
                    <i class="bi bi-grid-3x3-gap-fill me-1 text-primary"></i> Category Management
                </span>
            </div>
            <h1>Categories</h1>
            <p>Organize and manage the learning categories available across AI Skills Academy.</p>
        </div>
        <div class="position-relative">
            <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn-create-category">
                <i class="bi bi-plus-lg"></i> Add Category
            </a>
        </div>
    </div>

    @* ── Search Bar Card ── *@
    <div class="filter-card">
        <form method="get" asp-area="Admin" asp-controller="Categories" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-lg-8 col-md-7">
                <label for="search" class="form-label small fw-semibold text-muted mb-1">Search Categories</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" id="search" name="search" value="@search" class="form-control border-start-0 ps-0" placeholder="Search by category name or description..." />
                </div>
            </div>

            <div class="col-lg-4 col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-filter flex-grow-1">
                    <i class="bi bi-search me-1"></i> Search
                </button>
                @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(sortBy))
                {
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-reset" title="Clear Search">
                        <i class="bi bi-x-circle me-1"></i> Reset
                    </a>
                }
            </div>
        </form>
    </div>

    @* ── Categories Table Card ── *@
    <div class="table-card">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table categories-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 60px;">Icon</th>
                            <th>
                                <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                                   asp-route-sortBy="name"
                                   asp-route-sortDescending="@(sortBy == "name" ? !sortDescending : false)"
                                   asp-route-search="@search">
                                    Category Name
                                    @if (sortBy == "name")
                                    {
                                        <i class="bi bi-arrow-@(sortDescending ? "down" : "up") text-primary"></i>
                                    }
                                </a>
                            </th>
                            <th>Description</th>
                            <th>Courses</th>
                            <th>
                                <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                                   asp-route-sortBy="createdat"
                                   asp-route-sortDescending="@(sortBy == "createdat" ? !sortDescending : false)"
                                   asp-route-search="@search">
                                    Created Date
                                    @if (sortBy == "createdat")
                                    {
                                        <i class="bi bi-arrow-@(sortDescending ? "down" : "up") text-primary"></i>
                                    }
                                </a>
                            </th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="category-icon-box">
                                        <i class="bi bi-folder2-open"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="category-name-text">@cat.Name</div>
                                </td>
                                <td>
                                    <div class="category-desc-text" title="@cat.Description">
                                        @(string.IsNullOrWhiteSpace(cat.Description) ? "—" : cat.Description)
                                    </div>
                                </td>
                                <td>
                                    <span class="course-count-badge">
                                        <i class="bi bi-collection-fill"></i> @cat.CourseCount @(cat.CourseCount == 1 ? "Course" : "Courses")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">@cat.CreatedAt.ToString("MMM d, yyyy")</span>
                                </td>
                                <td>
                                    <div class="action-btn-group">
                                        <a asp-area="Admin" asp-controller="Categories" asp-action="Details" asp-route-id="@cat.Id"
                                           class="action-btn action-btn-view" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@cat.Id"
                                           class="action-btn action-btn-edit" title="Edit Category">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@cat.Id"
                                           class="action-btn action-btn-delete" title="Delete Category">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination *@
            <div class="p-3 border-top">
                <partial name="_Pagination" model="Model" />
            </div>
        }
        else
        {
            <div class="empty-categories">
                <i class="bi bi-grid-3x3-gap"></i>
                <h5 class="fw-bold text-dark mb-1">No Categories Found</h5>
                <p class="text-muted mb-3">No categories match your search criteria.</p>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-filter px-4">
                    <i class="bi bi-plus-lg me-1"></i> Add New Category
                </a>
            </div>
        }
    </div>

</div>
