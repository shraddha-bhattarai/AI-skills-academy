@model CategoryDto
@{
    ViewData["Title"] = "Delete Category";
    var relatedCourses = ViewBag.RelatedCourses as IReadOnlyList<CourseDto> ?? new List<CourseDto>();
}

@section Styles {
<style>
    .delete-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        padding: 2.25rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .delete-header {
        border-bottom: 1px solid #edf2f7;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .delete-header h2 {
        font-weight: 700;
        font-size: 1.5rem;
        color: #dc2626;
        margin-bottom: 0.25rem;
    }

    .delete-warning {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        border-radius: 12px;
        padding: 1.25rem;
        color: #991b1b;
        margin-bottom: 1.75rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .delete-warning i {
        font-size: 1.5rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .delete-blocked-alert {
        background: #fffbeb;
        border: 1px solid #fef3c7;
        border-radius: 12px;
        padding: 1.25rem;
        color: #92400e;
        margin-bottom: 1.75rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .delete-blocked-alert i {
        font-size: 1.5rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .summary-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid #edf2f7;
        margin-bottom: 1.75rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 0.6rem 0;
        border-bottom: 1px solid #edf2f7;
        font-size: 0.92rem;
    }

    .summary-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .summary-label {
        font-weight: 600;
        color: var(--lms-muted, #6a6f73);
    }

    .summary-value {
        font-weight: 600;
        color: var(--lms-dark, #1c1d1f);
    }

    .btn-delete-confirm {
        background: #dc2626;
        color: #fff;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.7rem 1.8rem;
        border: none;
        box-shadow: 0 4px 14px rgba(220, 38, 38, 0.25);
        transition: var(--lms-transition, all 0.2s ease);
    }

    .btn-delete-confirm:hover {
        background: #b91c1c;
        color: #fff;
        transform: translateY(-2px);
    }

    .btn-cancel {
        background: #f1f5f9;
        color: var(--lms-muted, #6a6f73);
        font-weight: 600;
        border-radius: 10px;
        padding: 0.7rem 1.5rem;
        border: none;
        text-decoration: none;
        transition: var(--lms-transition, all 0.2s ease);
        display: inline-flex;
        align-items: center;
    }

    .btn-cancel:hover {
        background: #e2e8f0;
        color: var(--lms-dark, #1c1d1f);
    }
</style>
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="text-decoration-none text-muted">Categories</a></li>
            <li class="breadcrumb-item active text-danger fw-semibold" aria-current="page">Delete Category</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="delete-card">
                <div class="delete-header">
                    <h2><i class="bi bi-trash3-fill me-2"></i>Delete Category</h2>
                    <p class="text-muted mb-0">Review category details before proceeding with deletion.</p>
                </div>

                @if (Model.CourseCount > 0)
                {
                    <div class="delete-blocked-alert">
                        <i class="bi bi-exclamation-octagon-fill text-warning"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Cannot Delete This Category</h6>
                            <p class="mb-2" style="font-size: 0.9rem;">
                                This category is currently assigned to <strong>@Model.CourseCount course(s)</strong>.
                                To protect platform integrity and prevent orphan records, you must reassign or remove all related courses before this category can be deleted.
                            </p>
                            <a asp-area="Admin" asp-controller="Courses" asp-action="Index" asp-route-categoryId="@Model.Id" class="btn btn-sm btn-outline-warning text-dark fw-semibold">
                                <i class="bi bi-collection me-1"></i> View Assigned Courses (@Model.CourseCount)
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="delete-warning">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            <strong>Warning:</strong> Are you sure you want to delete category <strong>"@Model.Name"</strong>? This action will soft-delete the category from AI Skills Academy.
                        </div>
                    </div>
                }

                <div class="summary-box">
                    <div class="summary-row">
                        <span class="summary-label">Category Name</span>
                        <span class="summary-value">@Model.Name</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Description</span>
                        <span class="summary-value">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Assigned Courses</span>
                        <span class="summary-value">
                            <span class="badge @(Model.CourseCount > 0 ? "bg-warning text-dark" : "bg-success-subtle text-success") rounded-pill">
                                @Model.CourseCount @(Model.CourseCount == 1 ? "course" : "courses")
                            </span>
                        </span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Created At</span>
                        <span class="summary-value">@Model.CreatedAt.ToString("MMM d, yyyy")</span>
                    </div>
                </div>

                <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-cancel">
                            <i class="bi bi-arrow-left me-1"></i> Back to Categories
                        </a>
                        @if (Model.CourseCount == 0)
                        {
                            <button type="submit" class="btn btn-delete-confirm">
                                <i class="bi bi-trash me-1"></i> Confirm Delete
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
