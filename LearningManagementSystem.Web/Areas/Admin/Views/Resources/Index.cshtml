@model IReadOnlyList<ResourceDto>
@{
    var lesson = ViewBag.Lesson as LessonDto;
    ViewData["Title"] = "Resources — " + lesson?.Title;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Lessons" asp-action="Index">Lessons</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson?.Id">@lesson?.Title</a></li>
            <li class="breadcrumb-item active">Resources</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="bi bi-paperclip me-2"></i>Resources for "@lesson?.Title"</h1>
        <a asp-area="Admin" asp-controller="Resources" asp-action="Create" asp-route-lessonId="@lesson?.Id" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Resource
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white rounded shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>File URL</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No resources added to this lesson yet.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td><a href="@item.FileUrl" target="_blank" rel="noopener noreferrer">@item.FileUrl</a></td>
                        <td class="text-end text-nowrap">
                            <a asp-area="Admin" asp-controller="Resources" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-area="Admin" asp-controller="Resources" asp-action="Delete" asp-route-id="@item.Id" asp-route-lessonId="@item.LessonId" method="post" class="d-inline" onsubmit="return confirm('Delete this resource?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a asp-area="Admin" asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson?.Id" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Lesson
    </a>
</div>
