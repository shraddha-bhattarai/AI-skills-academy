@model EnrollmentDto
@{
    ViewData["Title"] = "Enrollment Details";
    var course = ViewBag.Course as CourseDto;
    var studentDisplay = string.IsNullOrWhiteSpace(Model.StudentName) ? Model.StudentId : Model.StudentName;
    var statusClass = Model.Progress >= 100 ? "status-completed"
                    : Model.Progress > 0 ? "status-in-progress"
                    : "status-not-started";

    var statusText = Model.Progress >= 100 ? "Completed"
                   : Model.Progress > 0 ? "In Progress"
                   : "Not Started";
}

@section Styles {
<style>
    .details-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 50%, #4c1d95 100%);
        border-radius: var(--lms-radius, 16px);
        padding: 2.5rem 2rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .details-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(164, 53, 240, 0.25) 0%, transparent 60%);
    }

    .details-card {
        background: #fff;
        border-radius: var(--lms-radius, 16px);
        padding: 2rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
        height: 100%;
    }

    .meta-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1.25rem;
        border: 1px solid #edf2f7;
    }

    .meta-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--lms-muted, #6a6f73);
        margin-bottom: 0.25rem;
    }

    .meta-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--lms-dark, #1c1d1f);
    }

    .status-badge {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.3rem 0.8rem;
        border-radius: 50px;
    }

    .status-completed {
        background: rgba(16, 185, 129, 0.15);
        color: #059669;
    }

    .status-in-progress {
        background: rgba(59, 130, 246, 0.15);
        color: #2563eb;
    }

    .status-not-started {
        background: rgba(107, 114, 128, 0.15);
        color: #4b5563;
    }

    .progress-bar-custom {
        height: 10px;
        border-radius: 50px;
        background-color: #f1f5f9;
        overflow: hidden;
    }

    .progress-bar-fill {
        background: var(--lms-gradient, linear-gradient(135deg, #5624d0, #7c3aed));
        height: 100%;
        border-radius: 50px;
    }
</style>
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Enrollments" asp-action="Index" class="text-decoration-none text-muted">Enrollments</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Enrollment #@Model.Id</li>
        </ol>
    </nav>

    @* ── Header Hero ── *@
    <div class="details-hero">
        <div class="position-relative">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="status-badge @statusClass bg-white"><i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i> @statusText</span>
                <span class="badge rounded-pill bg-white text-dark px-3 py-1 fw-bold" style="font-size: 0.75rem;">
                    <i class="bi bi-journal-bookmark text-primary me-1"></i> @Model.CourseTitle
                </span>
            </div>
            <h1 class="fw-bold mb-2">@studentDisplay</h1>
            <p class="opacity-75 mb-0">
                Enrolled on @Model.EnrollmentDate.ToString("MMMM d, yyyy")
            </p>
        </div>
    </div>

    <div class="row g-4">
        @* ── Student & Course Info ── *@
        <div class="col-lg-8">
            <div class="details-card mb-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge-fill text-primary me-2"></i>Student Information</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="meta-box">
                            <div class="meta-label">Student Name / Email</div>
                            <div class="meta-value" style="font-size: 1rem;">@studentDisplay</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="meta-box">
                            <div class="meta-label">Student ID</div>
                            <div class="meta-value" style="font-size: 0.88rem; font-family: monospace;">@Model.StudentId</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="details-card">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text text-primary me-2"></i>Course Information</h5>
                    <a asp-area="Admin" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="small text-decoration-none text-primary fw-semibold">
                        View Course <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                @if (course != null)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="meta-box">
                                <div class="meta-label">Course Title</div>
                                <div class="meta-value" style="font-size: 1rem;">@course.Title</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="meta-box">
                                <div class="meta-label">Category</div>
                                <div class="meta-value" style="font-size: 1rem;">@course.CategoryName</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="meta-box">
                                <div class="meta-label">Level</div>
                                <div class="meta-value" style="font-size: 1rem;">@course.Level</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="meta-box">
                                <div class="meta-label">Price</div>
                                <div class="meta-value text-primary">@(course.Price == 0 ? "Free" : course.Price.ToString("C"))</div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="meta-box">
                        <div class="meta-label">Course Title</div>
                        <div class="meta-value">@Model.CourseTitle</div>
                    </div>
                }
            </div>
        </div>

        @* ── Sidebar Progress & Actions ── *@
        <div class="col-lg-4">
            <div class="details-card d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Learning Progress</h5>

                    <div class="meta-box mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="meta-label mb-0">Progress</div>
                            <div class="fw-bold text-primary">@Model.Progress%</div>
                        </div>
                        <div class="progress-bar-custom">
                            <div class="progress-bar-fill" style="width: @Math.Min(100, Math.Max(0, Model.Progress))%;"></div>
                        </div>
                    </div>

                    <div class="meta-box mb-4">
                        <div class="meta-label">Enrollment Status</div>
                        <div class="meta-value" style="font-size: 1rem;">
                            <span class="status-badge @statusClass">@statusText</span>
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top d-flex flex-column gap-2">
                    <a asp-area="Admin" asp-controller="Enrollments" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary w-100 fw-semibold" style="background: var(--lms-gradient); border: none; border-radius: 10px; padding: 0.65rem;">
                        <i class="bi bi-pencil-square me-1"></i> Edit Enrollment
                    </a>
                    <a asp-area="Admin" asp-controller="Enrollments" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger w-100 fw-semibold" style="border-radius: 10px; padding: 0.65rem;">
                        <i class="bi bi-trash me-1"></i> Cancel Enrollment
                    </a>
                    <a asp-area="Admin" asp-controller="Enrollments" asp-action="Index" class="btn btn-light w-100 text-muted fw-semibold" style="border-radius: 10px; padding: 0.65rem;">
                        <i class="bi bi-arrow-left me-1"></i> Back to Enrollments
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
