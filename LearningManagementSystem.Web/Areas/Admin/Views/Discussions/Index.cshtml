@model PagedResult<DiscussionDto>
@{
    ViewData["Title"] = "Discussions";
    var search = ViewBag.Search as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="bi bi-chat-left-text me-2"></i>Discussion Moderation</h1>
    </div>

    <form method="get" asp-area="Admin" asp-controller="Discussions" asp-action="Index" class="row g-2 mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search title, content, or course..." />
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white rounded shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Course</th>
                    <th>Posted By</th>
                    <th>Replies</th>
                    <th>Posted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No discussions found.</td></tr>
                }
                @foreach (var d in Model.Items)
                {
                    <tr>
                        <td>@d.Title</td>
                        <td>@d.CourseTitle</td>
                        <td>@d.StudentName</td>
                        <td>@d.ReplyCount</td>
                        <td>@d.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-area="Admin" asp-controller="Discussions" asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-info" title="View">
                                <i class="bi bi-eye"></i>
                            </a>
                            <form asp-area="Admin" asp-controller="Discussions" asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this discussion and all replies?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="Model" />
</div>
