@model DiscussionDetailsDto
@{
    ViewData["Title"] = "Discussion — " + Model.Title;
}

<div class="container py-4">
    <h1><i class="bi bi-chat-left-text me-2"></i>@Model.Title</h1>
    <p class="text-muted">@Model.CourseTitle &middot; by @Model.StudentName &middot; @Model.CreatedAt.ToString("g")</p>
    <hr />

    <div class="card mb-4">
        <div class="card-body">
            <p style="white-space: pre-line;">@Model.Content</p>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5>@Model.Replies.Count Repl@(Model.Replies.Count == 1 ? "y" : "ies")</h5>
        <form asp-area="Admin" asp-controller="Discussions" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this entire discussion?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash me-1"></i> Delete Discussion
            </button>
        </form>
    </div>

    @foreach (var reply in Model.Replies)
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <p class="mb-1 fw-semibold small">@reply.StudentName <span class="text-muted fw-normal">&middot; @reply.CreatedAt.ToString("g")</span></p>
                    <p class="mb-0" style="white-space: pre-line;">@reply.Content</p>
                </div>
                <form asp-area="Admin" asp-controller="Discussions" asp-action="DeleteReply" asp-route-replyId="@reply.Id" asp-route-discussionId="@Model.Id" method="post" onsubmit="return confirm('Delete this reply?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Reply">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </div>
        </div>
    }

    <a asp-area="Admin" asp-controller="Discussions" asp-action="Index" class="btn btn-secondary mt-3">
        <i class="bi bi-arrow-left me-1"></i>Back to Discussions
    </a>
</div>
