@{
    ViewData["Title"] = "Instructor Home";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 mb-3 text-success"><i class="bi bi-person-badge-fill me-2"></i>Instructor Dashboard</h1>
            <p class="lead">Welcome, Instructor.</p>
            <hr />
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border">
                        <h5>Role</h5>
                        <span class="badge bg-success fs-6">Instructor</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border">
                        <h5>Access Status</h5>
                        <span class="badge bg-success fs-6">Authorized</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border">
                        <h5>Area Route</h5>
                        <code>/Instructor/Home</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
