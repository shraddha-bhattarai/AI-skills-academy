@model LearningManagementSystem.Application.DTOs.AiTools.AiToolDetailsDto
@{
    ViewData["Title"] = Model.Name;
    Layout = "_StudentLayout";
}

<div class="container py-4">
    <div class="mb-3">
        <a asp-area="Student" asp-controller="AiTools" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to AI Tools
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h2 class="fw-bold text-dark mb-1">@Model.Name</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Category))
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill mb-2">@Model.Category</span>
                }
            </div>
            <a href="@Model.Url" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-box-arrow-up-right me-1"></i> Visit Tool
            </a>
        </div>
        <p class="text-secondary mt-3" style="white-space: pre-line;">@Model.Description</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-hand-thumbs-up me-2 text-primary"></i>Is this tool useful? (@Model.UsefulCount votes)</h5>
        <form asp-area="Student" asp-controller="AiTools" asp-action="MarkFeedback" method="post">
            <input type="hidden" name="AIToolId" value="@Model.Id" />
            <div class="mb-3">
                <textarea name="Comment" class="form-control" rows="2" placeholder="Optional feedback comment..."></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" name="IsUseful" value="true" class="btn @(Model.MarkedUsefulByCurrentUser ? "btn-success" : "btn-outline-success") rounded-pill px-4">
                    <i class="bi bi-hand-thumbs-up-fill me-1"></i> Useful
                </button>
                <button type="submit" name="IsUseful" value="false" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-hand-thumbs-down me-1"></i> Not Useful
                </button>
            </div>
        </form>
    </div>

    @if (Model.Comments.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-chat-square-text me-2 text-primary"></i>Student Feedback</h5>
            @foreach (var comment in Model.Comments)
            {
                <div class="border-bottom py-2">
                    <p class="mb-1 fw-semibold small">
                        @comment.StudentName
                        @if (comment.IsUseful)
                        {
                            <span class="badge bg-success-subtle text-success ms-1">Useful</span>
                        }
                        <span class="text-muted fw-normal">&middot; @comment.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </p>
                    <p class="mb-0 text-secondary">@comment.Comment</p>
                </div>
            }
        </div>
    }
</div>
