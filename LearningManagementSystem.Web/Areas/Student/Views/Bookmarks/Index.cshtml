@model IReadOnlyList<LearningManagementSystem.Application.DTOs.Bookmarks.BookmarkedCourseDto>
@{
    ViewData["Title"] = "My Bookmarks";
    Layout = "_StudentLayout";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-bookmark-star me-2 text-primary"></i>My Bookmarks</h2>
        <p class="text-muted mb-0">Courses you've saved for later.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-bookmark" style="font-size: 3rem;"></i>
            <p class="mt-3">You haven't bookmarked any courses yet.</p>
            <a asp-area="" asp-controller="Courses" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-search me-1"></i> Browse Courses
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var b in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="fw-bold text-dark mb-2">@b.CourseTitle</h5>
                            <p class="text-secondary small flex-grow-1">@b.CourseDescription</p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <a asp-area="" asp-controller="Courses" asp-action="Details" asp-route-id="@b.CourseId" class="btn btn-sm btn-primary rounded-pill">
                                    View Course
                                </a>
                                <form asp-area="Student" asp-controller="Bookmarks" asp-action="Toggle" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="courseId" value="@b.CourseId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Remove Bookmark">
                                        <i class="bi bi-bookmark-x"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
