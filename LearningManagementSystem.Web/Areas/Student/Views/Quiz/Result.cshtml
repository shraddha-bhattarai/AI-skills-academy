@model LearningManagementSystem.Web.Areas.Student.ViewModels.QuizResultViewModel
@{
    ViewData["Title"] = "Quiz Result - " + Model.QuizTitle;
    Layout = "_StudentLayout";
}

<style>
    .result-hero-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(86, 36, 208, 0.1);
        padding: 2.5rem 2rem;
        text-align: center;
        margin-bottom: 2rem;
    }
    .stat-box {
        background: #f8fafc;
        border-radius: 16px;
        padding: 1.25rem;
        border: 1px solid #e2e8f0;
        text-align: center;
    }
    .result-progress {
        height: 14px;
        border-radius: 50px;
        background-color: #e2e8f0;
        overflow: hidden;
    }
</style>

<div class="container py-4">
    <!-- Result Hero Card -->
    <div class="result-hero-card">
        @if (Model.IsPassed)
        {
            <div class="display-3 text-success mb-3">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-4 py-2 fs-6 fw-bold mb-3">
                <i class="bi bi-check-circle-fill me-1"></i> PASSED
            </span>
            <h2 class="fw-bold text-dark mb-1">Congratulations, @Model.StudentName!</h2>
            <p class="text-secondary mb-4">You have successfully passed the quiz for <strong>@Model.CourseTitle</strong>.</p>
        }
        else
        {
            <div class="display-3 text-warning mb-3">
                <i class="bi bi-patch-exclamation-fill"></i>
            </div>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-4 py-2 fs-6 fw-bold mb-3">
                <i class="bi bi-info-circle-fill me-1"></i> NEEDS IMPROVEMENT
            </span>
            <h2 class="fw-bold text-dark mb-1">Quiz Completed, @Model.StudentName</h2>
            <p class="text-secondary mb-4">Keep reviewing course materials to improve your score on future assessments.</p>
        }

        <h4 class="fw-bold text-dark mb-2">@Model.QuizTitle</h4>

        <!-- Score Breakdown Pill -->
        <div class="d-inline-flex align-items-center bg-light rounded-pill px-4 py-2 mb-4 border">
            <span class="fs-4 fw-bold text-primary me-2">@Model.Score</span>
            <span class="text-muted fs-5">/ @Model.TotalMarks pts</span>
            <span class="badge bg-primary rounded-pill ms-3 fs-6 px-3">@Model.Percentage%</span>
        </div>

        <!-- Percentage Progress Bar -->
        <div class="result-progress my-3 mx-auto" style="max-width: 500px;">
            <div class="progress-bar @(Model.IsPassed ? "bg-success" : "bg-warning")" role="progressbar" style="width: @Model.Percentage%;" aria-valuenow="@Model.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
        </div>

        <small class="text-muted d-block">Submitted on @Model.SubmittedAt.ToString("dddd, MMMM dd, yyyy hh:mm tt")</small>
    </div>

    <!-- Stat Counter Cards -->
    <div class="row g-3 mb-4">
        <div class="col-4">
            <div class="stat-box">
                <div class="p-2 bg-success bg-opacity-10 text-success rounded-3 d-inline-block mb-2">
                    <i class="bi bi-check-circle fs-3"></i>
                </div>
                <h3 class="fw-bold text-success mb-0">@Model.CorrectCount</h3>
                <small class="text-muted fw-medium">Correct Answers</small>
            </div>
        </div>
        <div class="col-4">
            <div class="stat-box">
                <div class="p-2 bg-danger bg-opacity-10 text-danger rounded-3 d-inline-block mb-2">
                    <i class="bi bi-x-circle fs-3"></i>
                </div>
                <h3 class="fw-bold text-danger mb-0">@Model.IncorrectCount</h3>
                <small class="text-muted fw-medium">Incorrect Answers</small>
            </div>
        </div>
        <div class="col-4">
            <div class="stat-box">
                <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3 d-inline-block mb-2">
                    <i class="bi bi-dash-circle fs-3"></i>
                </div>
                <h3 class="fw-bold text-warning-emphasis mb-0">@Model.UnansweredCount</h3>
                <small class="text-muted fw-medium">Unanswered</small>
            </div>
        </div>
    </div>

    <!-- Actions Footer -->
    <div class="text-center pt-2">
        <a asp-area="Student" asp-controller="Quiz" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4 me-2 shadow-sm">
            <i class="bi bi-list-task me-1"></i> Back to Quizzes
        </a>
        <a asp-area="Student" asp-controller="Quiz" asp-action="History" class="btn btn-outline-primary btn-lg rounded-pill px-4 me-2">
            <i class="bi bi-clock-history me-1"></i> My Quiz Results
        </a>
        <a asp-area="Student" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
            <i class="bi bi-speedometer2 me-1"></i> Student Dashboard
        </a>
    </div>
</div>
