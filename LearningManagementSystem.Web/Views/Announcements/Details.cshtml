@model AnnouncementDto
@{
    ViewData["Title"] = "Announcement Details";
}

<h1><i class="bi bi-megaphone me-2"></i>Announcement Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Message</dt>
    <dd class="col-sm-9">@Model.Message</dd>

    <dt class="col-sm-3">Publish Date</dt>
    <dd class="col-sm-9">@Model.PublishDate.ToString("g")</dd>

    <dt class="col-sm-3">Created At</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("g")</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="bi bi-pencil me-1"></i>Edit
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>
