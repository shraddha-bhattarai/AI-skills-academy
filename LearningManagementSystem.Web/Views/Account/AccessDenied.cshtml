@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-body p-5">
                    <div class="text-danger mb-3">
                        <i class="bi bi-shield-x-fill display-1"></i>
                    </div>
                    <h2 class="card-title text-danger mb-3">Access Denied</h2>
                    <p class="card-text text-muted mb-4">
                        You do not have permission to access this area. If you believe this is an error, please log in with an authorized account or contact your administrator.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-house-door me-1"></i> Return Home
                        </a>
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Log In with another account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
