<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
            && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
        var pageTitle = ViewData["Title"] as string;
    }
    <title>@(isHome ? "AI Skills Academy" : (string.IsNullOrEmpty(pageTitle) ? "AI Skills Academy" : $"{pageTitle} | AI Skills Academy"))</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="landing-page @(ViewData["BodyClass"] as string)">
    <partial name="_Navbar" />
    @if (ViewData["UseDashboardLayout"] as bool? == true)
    {
        @RenderBody()
    }
    else
    {
        <partial name="_AlertMessages" />
        <main role="main" class="lms-main">
            @RenderBody()
        </main>
        <partial name="_Footer" />
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
