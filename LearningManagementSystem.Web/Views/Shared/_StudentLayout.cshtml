@inject LearningManagementSystem.Application.Interfaces.Services.INotificationService _navNotifService
@inject Microsoft.AspNetCore.Identity.UserManager<LearningManagementSystem.Persistence.Identity.ApplicationUser> _navUserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Skills Academy Student Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        .student-nav {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(12px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            border-bottom: 1px solid rgba(86, 36, 208, 0.08);
            padding: 0.75rem 0;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
        }
        .student-nav .navbar-brand {
            font-weight: 800;
            font-size: 1.45rem;
            color: var(--lms-primary) !important;
            letter-spacing: -0.5px;
        }
        .student-nav .brand-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--lms-gradient);
            color: white;
            font-size: 1.1rem;
            margin-right: 0.5rem;
        }
        .student-nav .nav-link {
            font-weight: 500;
            font-size: 0.95rem;
            color: var(--lms-dark) !important;
            padding: 0.5rem 0.9rem !important;
            border-radius: 8px;
            transition: var(--lms-transition);
        }
        .student-nav .nav-link:hover,
        .student-nav .nav-link.active {
            color: var(--lms-primary) !important;
            background-color: rgba(86, 36, 208, 0.06);
        }
        /* Too many top-level nav items to fit one row on real desktop widths —
           scroll horizontally instead of letting flex shrink/crush the links. */
        @@media (min-width: 992px) {
            .student-nav .navbar-collapse {
                flex-wrap: nowrap;
                min-width: 0;
            }
            .student-nav .navbar-nav {
                flex-wrap: nowrap;
                overflow-x: auto;
                overflow-y: hidden;
                white-space: nowrap;
                scrollbar-width: thin;
                scrollbar-color: rgba(86, 36, 208, 0.35) transparent;
                padding-bottom: 2px;
                margin-left: auto;
                margin-right: auto;
            }
            .student-nav .navbar-nav .nav-item {
                flex-shrink: 0;
            }
            .student-nav .navbar-nav::-webkit-scrollbar {
                height: 5px;
            }
            .student-nav .navbar-nav::-webkit-scrollbar-thumb {
                background: rgba(86, 36, 208, 0.3);
                border-radius: 10px;
            }
            .student-nav .d-flex.align-items-center.gap-2.flex-wrap {
                flex-shrink: 0;
            }
        }
        .student-main-content {
            padding-top: var(--lms-nav-height);
            min-height: calc(100vh - 120px);
            background-color: #f8fafc;
        }
        .student-user-badge {
            background: linear-gradient(135deg, rgba(86, 36, 208, 0.08), rgba(124, 58, 237, 0.12));
            color: var(--lms-primary-dark);
            border-radius: 50px;
            padding: 0.4rem 1rem;
            font-weight: 600;
            font-size: 0.88rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-logout {
            background: rgba(236, 82, 82, 0.1);
            color: #d93838;
            font-weight: 600;
            border-radius: 50px;
            padding: 0.45rem 1.1rem;
            border: 1px solid rgba(236, 82, 82, 0.2);
            transition: var(--lms-transition);
            font-size: 0.9rem;
        }
        .btn-logout:hover {
            background: #d93838;
            color: white;
        }
    </style>
</head>
<body class="landing-page">
    @{
        var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    }

    <header>
        <nav class="navbar navbar-expand-lg student-nav" id="studentNavbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
                    AI Skills Academy
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#studentNavMenu"
                        aria-controls="studentNavMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="studentNavMenu">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(area == "Student" && controller == "Home" && action == "Index" ? "active" : "")"
                               asp-area="Student" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(area == "Student" && controller == "Courses" ? "active" : "")"
                               asp-area="Student" asp-controller="Courses" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-1"></i> My Courses
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(area == "Student" && controller == "Assignments" ? "active" : "")"
                               asp-area="Student" asp-controller="Assignments" asp-action="Index">
                                <i class="bi bi-file-earmark-check me-1"></i> Assignments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(area == "Student" && controller == "Quiz" ? "active" : "")"
                               asp-area="Student" asp-controller="Quiz" asp-action="Index">
                                <i class="bi bi-patch-question me-1"></i> Quizzes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(area == "Student" && controller == "AiTools" ? "active" : "")"
                               asp-area="Student" asp-controller="AiTools" asp-action="Index">
                                <i class="bi bi-robot me-1"></i> AI Tools
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(area == "Student" && controller == "Bookmarks" ? "active" : "")"
                               asp-area="Student" asp-controller="Bookmarks" asp-action="Index">
                                <i class="bi bi-bookmark-star me-1"></i> Bookmarks
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(area == "Student" && (controller == "Certificate" || controller == "Certificates") ? "active" : "")"
                               asp-area="Student" asp-controller="Certificate" asp-action="Index">
                                <i class="bi bi-award me-1"></i> Certificates
                            </a>
                        </li>
                        <li class="nav-item">
                            @{
                                var _navUser = await _navUserManager.GetUserAsync(User);
                                int _navUnreadCount = 0;
                                if (_navUser != null)
                                {
                                    _navUnreadCount = await _navNotifService.GetUnreadCountAsync(_navUser.Id);
                                }
                            }
                            <a class="nav-link @(area == "Student" && controller == "Notification" ? "active" : "")"
                               asp-area="Student" asp-controller="Notification" asp-action="Index">
                                <i class="bi bi-bell me-1"></i> Notifications
                                @if (_navUnreadCount > 0)
                                {
                                    <span class="badge rounded-pill ms-1" style="background: var(--lms-primary); color: white; font-size: 0.68rem; padding: 0.2em 0.5em; vertical-align: middle;">@_navUnreadCount</span>
                                }
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <a asp-area="Student" asp-controller="Profile" asp-action="Index" class="student-user-badge text-decoration-none @(area == "Student" && controller == "Profile" ? "active" : "")">
                            <i class="bi bi-person-circle fs-6"></i>
                            <span>@(User.Identity?.Name ?? "Student")</span>
                        </a>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="student-main-content">
        <partial name="_AlertMessages" />
        @RenderBody()
    </main>

    <footer class="landing-footer py-4 mt-5">
        <div class="container text-center">
            <div class="footer-brand d-inline-flex align-items-center gap-2 mb-2">
                <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
                AI Skills Academy Student Portal
            </div>
            <p class="footer-desc mb-2">Learn AI basics, practice your skills and follow your progress.</p>
            <div class="footer-bottom border-0 pt-0">
                &copy; @DateTime.UtcNow.Year AI Skills Academy. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
