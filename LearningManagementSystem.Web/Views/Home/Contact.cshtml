@model LearningManagementSystem.Application.DTOs.ContactMessages.CreateContactMessageDto
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Contact Us";
}

<style>
    .page-hero {
        background: linear-gradient(135deg, #5624d0 0%, #7c3aed 60%, #6d28d9 100%);
        padding: 3.5rem 0 2.5rem;
        color: #fff;
    }

        .page-hero .breadcrumb-trail {
            font-size: .9rem;
            opacity: .85;
            margin-bottom: .75rem;
        }

            .page-hero .breadcrumb-trail a {
                color: #fff;
                text-decoration: none;
                opacity: .9;
            }

                .page-hero .breadcrumb-trail a:hover {
                    text-decoration: underline;
                }

        .page-hero h1 {
            font-weight: 700;
            font-size: 2.4rem;
            margin-bottom: .5rem;
        }

        .page-hero p {
            opacity: .9;
            max-width: 680px;
            margin-bottom: 0;
        }

    .contact-card {
        background: #fff;
        border: 1px solid rgba(0, 0, 0, 0.07);
        border-radius: var(--lms-radius);
        padding: 2rem;
        height: 100%;
        transition: var(--lms-transition);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

        .contact-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--lms-shadow-hover);
        }

    .contact-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        margin-bottom: 1.25rem;
    }

    .contact-form-card {
        background: #fff;
        border: 1px solid rgba(0, 0, 0, 0.07);
        border-radius: var(--lms-radius);
        padding: 2.5rem;
        box-shadow: var(--lms-shadow);
    }

    .form-floating > .form-control:focus,
    .form-floating > .form-control:not(:placeholder-shown) {
        padding-top: 1.625rem;
        padding-bottom: .625rem;
    }

    .form-control:focus {
        border-color: var(--lms-primary);
        box-shadow: 0 0 0 0.25rem rgba(86, 36, 208, 0.15);
    }

    .btn-submit-contact {
        background: var(--lms-gradient);
        color: white;
        font-weight: 600;
        border-radius: 50px;
        padding: 0.8rem 2.2rem;
        border: none;
        transition: var(--lms-transition);
    }

        .btn-submit-contact:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(86, 36, 208, 0.35);
            color: white;
        }

    .faq-item {
        background: #fff;
        border: 1px solid rgba(0, 0, 0, 0.07);
        border-radius: var(--lms-radius-sm);
        padding: 1.5rem;
        margin-bottom: 1rem;
    }
</style>

<partial name="_Navbar" />

<section class="page-hero">
    <div class="container">
        <div class="breadcrumb-trail">
            <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            <span class="mx-2 opacity-50">/</span>
            <span>Contact</span>
        </div>
        <h1>Get in Touch</h1>
        <p>Send a question or share feedback with the academy team.</p>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h3 class="fw-bold mb-2">Send Us a Message</h3>
                    <p class="text-muted mb-4">Use this form to save a message for the academy administrator.</p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <div>@TempData["Success"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-area="" asp-controller="Home" asp-action="Contact" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label fw-semibold">Your Name <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="form-control form-control-lg" placeholder="John Doe" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                    <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="john@example.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control form-control-lg" placeholder="How can we help you?" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Message" class="form-label fw-semibold">Message <span class="text-danger">*</span></label>
                            <textarea asp-for="Message" class="form-control" rows="5" placeholder="Write your message here..."></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-submit-contact d-inline-flex align-items-center gap-2">
                            <i class="bi bi-send-fill"></i>
                            <span>Send Message</span>
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="ps-lg-3">
                    <h4 class="fw-bold mb-3">Frequently Asked Questions</h4>
                    <div class="faq-item">
                        <h6 class="fw-bold mb-1"><i class="bi bi-question-circle-fill text-primary me-2"></i>How do I enroll in a course?</h6>
                        <p class="text-muted small mb-0">You can create a free account, browse our course catalog, and click the "Enroll" button on any course detail page.</p>
                    </div>
                    <div class="faq-item">
                        <h6 class="fw-bold mb-1"><i class="bi bi-question-circle-fill text-primary me-2"></i>How are certificates issued?</h6>
                        <p class="text-muted small mb-0">Once you meet the course requirements, you can view your certificate in your student portal.</p>
                    </div>
                    <div class="faq-item">
                        <h6 class="fw-bold mb-1"><i class="bi bi-question-circle-fill text-primary me-2"></i>Can I access courses on mobile?</h6>
                        <p class="text-muted small mb-0">You can open the website in a modern browser on a phone, tablet or computer.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="section-padding bg-soft">
    <div class="container">
        <div class="cta-section">
            <h2>Ready to Start Learning?</h2>
            <p>Create an account to join courses, take quizzes and track your progress.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-area="" asp-controller="Account" asp-action="Register" class="btn-white">Register</a>
                <a asp-area="" asp-controller="Courses" asp-action="Index" class="btn-outline-white">Browse Courses</a>
            </div>
        </div>
    </div>
</section>

<partial name="_Footer" />
